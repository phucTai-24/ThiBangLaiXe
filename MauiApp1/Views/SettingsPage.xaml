<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.SettingsPage"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Style="{StaticResource AppHeaderContainer}"
                BackgroundColor="#FFFFFF"
                Shadow="0,8,20,#0D000000">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12">
                <Border BackgroundColor="#F0ECFF"
                        StrokeThickness="0"
                        WidthRequest="46"
                        HeightRequest="46"
                        StrokeShape="RoundRectangle 16"
                        VerticalOptions="Center">
                    <Label Text="←"
                           FontSize="22"
                           TextColor="#5B4AE6"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                </Border>
 
                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="ONTHIBANGLAI"
                           FontFamily="OpenSans-Semibold"
                           FontSize="10"
                           CharacterSpacing="2"
                           TextColor="#999999" />
                    <Label Text="Cài đặt"
                           FontFamily="OpenSans-Semibold"
                           FontSize="20"
                           TextColor="#222222" />
                </VerticalStackLayout>
 
                <Label Grid.Column="2"
                       Text="⚙️"
                       FontSize="20"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,24,24,140" Spacing="24">
                <Border Padding="20" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 24" Shadow="0,10,24,#0F000000">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border WidthRequest="64" HeightRequest="64" BackgroundColor="#E5E2DB" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                            <Label Text="👨" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label Text="Thiết lập ứng dụng" FontFamily="OpenSans-Semibold" FontSize="20" TextColor="#222222" />
                            <Label Text="Cá nhân hóa trải nghiệm học và ôn thi" FontSize="13" TextColor="#666666" />
                            <Label x:Name="SettingsSummaryLabel" Text="Đang tải cài đặt" FontSize="13" TextColor="#999999" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Tài khoản" FontFamily="OpenSans-Semibold" FontSize="21" TextColor="#271900" Margin="4,0,0,0" />

                    <Border Padding="18" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 22" Shadow="0,10,24,#0F000000">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#F0ECFF" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                                <Label Text="👤" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Thông tin cá nhân" FontFamily="OpenSans-Semibold" FontSize="17" TextColor="#271900" />
                                <Label Text="Cập nhật họ tên, email và số điện thoại" FontSize="13" TextColor="#5F564B" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#837560" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileInfoTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <Border Padding="18" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 22" Shadow="0,10,24,#0F000000">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#F0ECFF" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                                <Label Text="🔒" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Mật khẩu và bảo mật" FontFamily="OpenSans-Semibold" FontSize="17" TextColor="#271900" />
                                <Label Text="Đổi mật khẩu, xác thực và quyền riêng tư" FontSize="13" TextColor="#5F564B" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#837560" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSecurityTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Giao diện" FontFamily="OpenSans-Semibold" FontSize="21" TextColor="#271900" Margin="4,0,0,0" />

                    <Border Padding="18" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 22" Shadow="0,10,24,#0F000000">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#F0ECFF" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                                <Label Text="🌗" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Chế độ hiển thị" FontFamily="OpenSans-Semibold" FontSize="17" TextColor="#271900" />
                                <Label x:Name="ThemeStatusLabel" Text="Sáng" FontSize="13" TextColor="#5F564B" />
                            </VerticalStackLayout>
                            <Switch x:Name="ThemeSwitch" Grid.Column="2" Toggled="OnThemeSwitchToggled" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Tùy chọn" FontFamily="OpenSans-Semibold" FontSize="21" TextColor="#271900" Margin="4,0,0,0" />

                    <Border Padding="18" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 22" Shadow="0,10,24,#0F000000">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#F0ECFF" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                                <Label Text="🔔" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Thông báo học tập" FontFamily="OpenSans-Semibold" FontSize="17" TextColor="#271900" />
                                <Label x:Name="NotificationStatusLabel" Text="Bật nhắc nhở ôn bài và lịch học" FontSize="13" TextColor="#5F564B" />
                            </VerticalStackLayout>
                            <Switch x:Name="NotificationSwitch" Grid.Column="2" Toggled="OnNotificationSwitchToggled" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border Padding="18" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 22" Shadow="0,10,24,#0F000000">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#F0ECFF" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                                <Label Text="🌐" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Ngôn ngữ" FontFamily="OpenSans-Semibold" FontSize="17" TextColor="#271900" />
                                <Label x:Name="LanguageLabel" Text="Tiếng Việt" FontSize="13" TextColor="#5F564B" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#837560" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <Border Padding="18" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#F0ECFF" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                                    <Label Text="🤖" FontSize="22" TextColor="#7C5800" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="Gemini API Key" FontFamily="OpenSans-Semibold" FontSize="17" TextColor="#271900" />
                                    <Label Text="Dán API key từ Google AI Studio để dùng chat AI" FontSize="13" TextColor="#5F564B" />
                                </VerticalStackLayout>
                            </Grid>

                            <Entry x:Name="GeminiApiKeyEntry"
                                   Placeholder="AIza..."
                                   IsPassword="True"
                                   BackgroundColor="#FFFFFF"
                                   TextColor="#271900"
                                   PlaceholderColor="#A59A8A"
                                   ClearButtonVisibility="WhileEditing"
                                   HeightRequest="44" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button Text="Lưu key"
                                        Clicked="OnSaveGeminiApiKeyClicked"
                                        BackgroundColor="#FFB800"
                                        TextColor="#271900"
                                        CornerRadius="12"
                                        HeightRequest="42" />
                                <Button Grid.Column="1"
                                        Text="Xóa key"
                                        Clicked="OnClearGeminiApiKeyClicked"
                                        BackgroundColor="#FFFFFF"
                                        TextColor="#7C5800"
                                        BorderColor="#E2D7C6"
                                        BorderWidth="1"
                                        CornerRadius="12"
                                        HeightRequest="42" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Thông tin" FontFamily="OpenSans-Semibold" FontSize="21" TextColor="#271900" Margin="4,0,0,0" />

                    <Border Padding="18" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 22" Shadow="0,10,24,#0F000000">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                                <Label Text="❓" FontSize="22" TextColor="#7C5800" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Trợ giúp" FontFamily="OpenSans-Semibold" FontSize="17" TextColor="#271900" />
                                <Label Text="Câu hỏi thường gặp và hỗ trợ người dùng" FontSize="13" TextColor="#5F564B" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#837560" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHelpTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <Border Padding="18" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 22" Shadow="0,10,24,#0F000000">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                                <Label Text="ℹ" FontSize="22" TextColor="#7C5800" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Phiên bản ứng dụng" FontFamily="OpenSans-Semibold" FontSize="17" TextColor="#271900" />
                                <Label x:Name="VersionLabel" Text="ONTHIBANGLAI" FontSize="13" TextColor="#5F564B" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="›" FontSize="24" TextColor="#837560" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVersionTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Border Padding="18" BackgroundColor="#FFF1EF" StrokeThickness="0" StrokeShape="RoundRectangle 22" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FFDAD6" StrokeThickness="0" StrokeShape="RoundRectangle 24">
                            <Label Text="⇥" FontSize="22" TextColor="#BA1A1A" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="Đăng xuất" FontFamily="OpenSans-Semibold" FontSize="17" TextColor="#BA1A1A" />
                            <Label Text="Thoát tài khoản hiện tại trên thiết bị này" FontSize="13" TextColor="#93000A" />
                        </VerticalStackLayout>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNavView Grid.Row="2" CurrentTab="profile" />
        <controls:ChatOverlayView Grid.RowSpan="3" />
    </Grid>

</ContentPage>
