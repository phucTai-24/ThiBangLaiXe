<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.ForgotPasswordPage"
             Style="{StaticResource AppPageStyle}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0"
              Padding="20,18"
              ColumnDefinitions="Auto,*">
            <Button Text="←"
                    WidthRequest="40"
                    HeightRequest="40"
                    CornerRadius="20"
                    BackgroundColor="Transparent"
                    TextColor="#7C5800"
                    FontSize="18"
                    Clicked="OnBackTapped" />

            <Label Grid.Column="1"
                   Text="ThiXeMay"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   FontFamily="OpenSans-Semibold"
                   FontAttributes="Bold,Italic"
                   FontSize="22"
                   TextColor="#7C5800" />
        </Grid>

        <Grid Grid.Row="1">
            <AbsoluteLayout InputTransparent="True">
                <BoxView
                    AbsoluteLayout.LayoutBounds="250,80,240,240"
                    AbsoluteLayout.LayoutFlags="None"
                    Color="#FFDEA8"
                    CornerRadius="120"
                    Opacity="0.3" />

                <BoxView
                    AbsoluteLayout.LayoutBounds="-40,420,280,280"
                    AbsoluteLayout.LayoutFlags="None"
                    Color="#A0C7FF"
                    CornerRadius="140"
                    Opacity="0.18" />
            </AbsoluteLayout>

            <ScrollView>
                <VerticalStackLayout Padding="24,20,24,24"
                                     Spacing="0">
                    <VerticalStackLayout HorizontalOptions="Center"
                                         Spacing="0"
                                         Margin="0,24,0,0">
                        <Border WidthRequest="96"
                                HeightRequest="96"
                                BackgroundColor="#FFDEA8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28"
                                Shadow="0,8,24,#1A7C5800">
                            <Label Text="🔐"
                                   FontSize="44"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <Label Text="Quên mật khẩu?"
                               Margin="0,28,0,0"
                               FontFamily="OpenSans-Semibold"
                               FontSize="32"
                               TextColor="#1C1C18"
                               HorizontalTextAlignment="Center" />

                        <Label Text="Nhập địa chỉ email của bạn bên dưới, chúng tôi sẽ gửi hướng dẫn để bạn có thể đặt lại mật khẩu mới."
                               Margin="12,16,12,0"
                               FontSize="16"
                               TextColor="#514532"
                               HorizontalTextAlignment="Center"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Border Margin="0,36,0,0"
                            Padding="24"
                            BackgroundColor="White"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 32"
                            Shadow="0,16,32,#0F1C1C18">
                        <VerticalStackLayout Spacing="28">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Địa chỉ Email"
                                       FontSize="14"
                                       FontFamily="OpenSans-Semibold"
                                       TextColor="#514532" />

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">
                                    <Label Text="✉"
                                           FontSize="18"
                                           VerticalTextAlignment="Center"
                                           TextColor="#514532" />
                                    <Entry Grid.Column="1"
                                           Placeholder="name@example.com"
                                           Keyboard="Email"
                                           BackgroundColor="Transparent"
                                           TextColor="#1C1C18"
                                           PlaceholderColor="#99837560" />
                                </Grid>

                                <BoxView HeightRequest="2"
                                         Color="#33837560" />
                            </VerticalStackLayout>

                            <Button Text="Send reset link  →"
                                    HeightRequest="58"
                                    CornerRadius="29"
                                    BackgroundColor="#FFB800"
                                    TextColor="#271900"
                                    FontFamily="OpenSans-Semibold"
                                    FontSize="18"
                                    Shadow="0,10,20,#33FFB800" />
                        </VerticalStackLayout>
                    </Border>

                    <HorizontalStackLayout HorizontalOptions="Center"
                                           Margin="0,28,0,0"
                                           Spacing="6">
                        <Label Text="←"
                               FontSize="16"
                               TextColor="#7C5800" />
                        <Label Text="Quay lại trang đăng nhập"
                               FontSize="15"
                               FontFamily="OpenSans-Semibold"
                               TextColor="#7C5800">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Label Grid.Row="2"
               Margin="0,0,0,24"
               Text="© 2024 THIXEMAY. GIẤY PHÉP LÁI XE A1 &#38; A2."
               FontSize="10"
               FontFamily="OpenSans-Semibold"
               TextColor="#837560"
               HorizontalTextAlignment="Center" />
    </Grid>

</ContentPage>
