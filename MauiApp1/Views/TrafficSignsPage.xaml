<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             xmlns:models="clr-namespace:MauiApp1.Models"
             x:Class="MauiApp1.Views.TrafficSignsPage"
             x:DataType="vm:PracticeViewModel"
             BackgroundColor="#FCF9F2">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Style="{StaticResource AppHeaderContainer}"
                Shadow="0,8,20,#12000000">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Style="{StaticResource AppHeaderGrid}">
                <Border Style="{StaticResource AppIconButtonCard}"
                        VerticalOptions="Center">
                    <Label Text="←"
                           FontSize="18"
                           TextColor="{StaticResource AppPrimaryText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="ONTHIBANGLAI"
                           Style="{StaticResource AppHeaderBrandLabel}" />
                    <Label Text="Ôn tập lý thuyết"
                           Style="{StaticResource AppHeaderTitleLabel}"
                           FontSize="22"
                           TextColor="{StaticResource AppBrand}" />
                </VerticalStackLayout>

                <Label Grid.Column="2"
                       Text="MOCK DATA"
                       Style="{StaticResource AppHeaderTrailingLabel}"
                       FontAttributes="Italic"
                       FontSize="12" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,20,24,140" Spacing="18">
                <Border BackgroundColor="#FFF8E8"
                        Padding="20"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Phiên ôn tập mock"
                               FontFamily="OpenSans-Semibold"
                               FontSize="22"
                               TextColor="#271900" />
                        <Label Text="{Binding PracticeSummaryText}"
                               FontSize="13"
                               LineHeight="1.35"
                               TextColor="#5F564B" />
                        <Label Text="{Binding LastSessionText}"
                               FontFamily="OpenSans-Semibold"
                               FontSize="13"
                               TextColor="{StaticResource AppBrand}" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource AppBrand}"
                        Padding="22"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Phiên ôn tập đề xuất"
                               FontFamily="OpenSans-Semibold"
                               FontSize="22"
                               TextColor="#FFF8E8" />
                        <Label Text="{Binding RecommendedTopic.Description}"
                               FontSize="13"
                               LineHeight="1.35"
                               TextColor="#F5E4B7" />

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                            <Border BackgroundColor="#19FFFFFF"
                                    Padding="12,8"
                                    Stroke="#26FFFFFF"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 999">
                                <Label Text="{Binding RecommendedTopic.AccentEmoji}"
                                       FontSize="18" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding RecommendedTopic.Name}"
                                       FontFamily="OpenSans-Semibold"
                                       FontSize="16"
                                       TextColor="#FFF8E8" />
                                <Label Text="{Binding RecommendedTopic.QuestionCount, StringFormat='Bộ chủ đề có {0} câu hỏi mock'}"
                                       FontSize="12"
                                       TextColor="#F5E4B7" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border BackgroundColor="{StaticResource AppBrandAccent}"
                                Padding="14,10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                HorizontalOptions="Start">
                            <Label Text="Bắt đầu ôn tập mock"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="13"
                                   TextColor="{StaticResource AppBrandStrong}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding StartRecommendedPracticeCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12"
                                     BindableLayout.ItemsSource="{Binding Topics}">
                    <Label Text="Chủ đề ôn tập"
                           FontFamily="OpenSans-Semibold"
                           FontSize="20"
                           TextColor="#271900" />
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PracticeTopic">
                            <Border Padding="18"
                                    Margin="0,0,0,14"
                                    BackgroundColor="#FFFFFF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24"
                                    Shadow="0,16,32,#0A1C1C18">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="16">
                                    <Border WidthRequest="72"
                                            HeightRequest="72"
                                            BackgroundColor="#F6F3EC"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18">
                                        <Label Text="{Binding AccentEmoji}"
                                               FontSize="34"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="6">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Name}"
                                                   FontFamily="OpenSans-Semibold"
                                                   FontSize="18"
                                                   TextColor="#271900" />
                                            <Border Padding="8,4"
                                                    BackgroundColor="#FFF1D6"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10"
                                                    IsVisible="{Binding IsRecommended}">
                                                <Label Text="Gợi ý"
                                                       FontFamily="OpenSans-Semibold"
                                                       FontSize="10"
                                                       TextColor="#7C5800" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Description}"
                                               FontSize="13"
                                               LineHeight="1.35"
                                               TextColor="#5F564B" />
                                        <Label Text="{Binding QuestionCount, StringFormat='Sẵn sàng {0} câu hỏi mock theo Demo.docx'}"
                                               FontFamily="OpenSans-Semibold"
                                               FontSize="12"
                                               TextColor="{StaticResource AppBrand}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StartTopicPracticeCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12"
                                     BindableLayout.ItemsSource="{Binding PracticeHistory}">
                    <Label Text="Lịch sử ôn tập mock"
                           FontFamily="OpenSans-Semibold"
                           FontSize="20"
                           TextColor="#271900" />
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PracticeHistoryItem">
                            <Border BackgroundColor="#FFFFFF"
                                    Padding="18"
                                    Margin="0,0,0,12"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20"
                                    Shadow="0,12,24,#081C1C18">
                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto"
                                      ColumnSpacing="10"
                                      RowSpacing="6">
                                    <Label Text="{Binding Topic}"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="16"
                                           TextColor="#271900" />
                                    <Border Grid.Column="1"
                                            Padding="10,6"
                                            BackgroundColor="#FFF1D6"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 999">
                                        <Label Text="{Binding Score, StringFormat='Điểm {0}'}"
                                               FontFamily="OpenSans-Semibold"
                                               FontSize="11"
                                               TextColor="#7C5800" />
                                    </Border>
                                    <Label Grid.Row="1"
                                           Text="{Binding CorrectAnswers, StringFormat='Đúng {0} câu'}"
                                           FontSize="13"
                                           TextColor="#5F564B" />
                                    <Label Grid.Row="1"
                                           Grid.Column="1"
                                           Text="{Binding TotalQuestions, StringFormat='/ {0} câu'}"
                                           FontSize="13"
                                           TextColor="#5F564B"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding PracticedAtText}"
                                           FontSize="12"
                                           TextColor="#9B8F7C" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                Margin="12,0,12,12"
                Padding="10,10,10,18"
                BackgroundColor="#CCFCF9F2"
                Stroke="#14D5C4AB"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 34"
                Shadow="0,-8,24,#0A000000">
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="6">
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="⌂" FontSize="18" TextColor="#6B6257" HorizontalOptions="Center" />
                    <Label Text="Trang chủ" FontSize="11" TextColor="#6B6257" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoHomeCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                    <Label Text="🧪" FontSize="18" TextColor="#6B6257" HorizontalOptions="Center" />
                    <Label Text="Luyện thi" FontSize="11" TextColor="#6B6257" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoMockExamCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                    <Border Padding="12,8"
                            BackgroundColor="#FFDEA8"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22">
                        <Label Text="📚" FontSize="18" TextColor="#271900" HorizontalOptions="Center" />
                    </Border>
                    <Label Text="Ôn tập" FontSize="11" TextColor="#7C5800" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                    <Label Text="🔔" FontSize="18" TextColor="#6B6257" HorizontalOptions="Center" />
                    <Label Text="Thông báo" FontSize="11" TextColor="#6B6257" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
                    <Label Text="👤" FontSize="18" TextColor="#6B6257" HorizontalOptions="Center" />
                    <Label Text="Cá nhân" FontSize="11" TextColor="#6B6257" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
