<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             xmlns:models="clr-namespace:MauiApp1.Models"
             x:Class="MauiApp1.Views.MockExamPage"
             x:DataType="vm:MockExamViewModel"
             Style="{StaticResource AppPageStyle}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource AppHeaderContainer}"
                Shadow="0,8,20,#12000000">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">
                <Border WidthRequest="42"
                        HeightRequest="42"
                        BackgroundColor="{StaticResource AppSurface}"
                        Stroke="{StaticResource AppBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        VerticalOptions="Center">
                    <Label Text="←"
                           FontSize="18"
                           TextColor="{StaticResource AppPrimaryText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="ONTHIBANGLAI"
                           FontFamily="OpenSans-Semibold"
                           FontSize="10"
                           CharacterSpacing="2"
                           TextColor="{StaticResource AppTertiaryText}" />
                    <Label Text="Thi thử trắc nghiệm"
                           FontFamily="OpenSans-Semibold"
                           FontSize="20"
                           TextColor="{StaticResource AppPrimaryText}" />
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        Padding="12,6"
                        BackgroundColor="{StaticResource AppSurfaceAccent}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="⏱"
                               FontSize="14"
                               TextColor="{StaticResource AppBrand}"
                               VerticalTextAlignment="Center" />
                        <Label Text="{Binding TimeRemainingText}"
                               FontFamily="OpenSans-Semibold"
                               FontSize="14"
                               TextColor="{StaticResource AppBrand}"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,18,24,140"
                                 Spacing="20">
                <!-- Progress -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding CurrentQuestionText}"
                               FontFamily="OpenSans-Semibold"
                               FontSize="28"
                               FontAttributes="Italic"
                               TextColor="{StaticResource AppPrimaryText}" />
                        <Label Grid.Column="1"
                               Text="{Binding CurrentExam.LicenseType, StringFormat='Hạng {0}'}"
                               FontFamily="OpenSans-Semibold"
                               FontSize="11"
                               CharacterSpacing="2"
                               TextColor="{StaticResource AppBrand}"
                               VerticalOptions="End" />
                    </Grid>
                    <Grid HeightRequest="10">
                        <Border BackgroundColor="#E5E2DB"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999" />
                        <Border WidthRequest="{Binding CurrentExam.AnsweredQuestions, Converter={StaticResource ProgressConverter}}"
                                HorizontalOptions="Start"
                                BackgroundColor="{StaticResource AppBrand}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Question Card -->
                <VerticalStackLayout Spacing="18"
                                     IsVisible="{Binding CurrentQuestion, Converter={StaticResource IsNotNullConverter}}">
                    <Border Style="{StaticResource AppMutedCard}"
                            Padding="22">
                        <VerticalStackLayout Spacing="18">
                            <Label Text="{Binding CurrentQuestion.Text}"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="24"
                                   LineHeight="1.3"
                                   TextColor="{StaticResource AppPrimaryText}" />

                            <!-- Image (if exists) -->
                            <Border Padding="10"
                                    BackgroundColor="{StaticResource AppSurface}"
                                    Stroke="{StaticResource AppBorder}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding CurrentQuestion.ImageUrl, Converter={StaticResource IsNotNullConverter}}">
                                <Border WidthRequest="220"
                                        HeightRequest="160"
                                        BackgroundColor="{StaticResource AppSurfaceAccent}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16">
                                    <Label Text="⚠"
                                           FontSize="72"
                                           TextColor="{StaticResource AppBrandAccent}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Border>

                            <!-- Answers -->
                            <BindableLayout.ItemsSource>
                                <Binding Path="CurrentQuestion.Answers" />
                            </BindableLayout.ItemsSource>
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Answer">
                                    <Border Padding="16"
                                            Margin="0,0,0,12"
                                            StrokeShape="RoundRectangle 18">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BackgroundColor" Value="{StaticResource AppSurface}" />
                                                <Setter Property="StrokeThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource AppSelectedAnswerLight}" />
                                                        <Setter Property="Stroke" Value="{StaticResource AppSelectedAnswer}" />
                                                        <Setter Property="StrokeThickness" Value="3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <HorizontalStackLayout Spacing="14">
                                            <Border WidthRequest="40"
                                                    HeightRequest="40"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 20">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource AppSurfaceMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Border"
                                                                         Binding="{Binding IsSelected}"
                                                                         Value="True">
                                                                <Setter Property="BackgroundColor" Value="{StaticResource AppSelectedAnswer}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Label Text="{Binding Label}"
                                                       FontFamily="OpenSans-Semibold"
                                                       FontSize="16"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center">
                                                    <Label.Style>
                                                        <Style TargetType="Label">
                                                            <Setter Property="TextColor" Value="{StaticResource AppSecondaryText}" />
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Label"
                                                                             Binding="{Binding IsSelected}"
                                                                             Value="True">
                                                                    <Setter Property="TextColor" Value="{StaticResource AppSurface}" />
                                                                    <Setter Property="FontFamily" Value="OpenSans-Semibold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Label.Style>
                                                </Label>
                                            </Border>
                                            <Label Text="{Binding Text}"
                                                   FontSize="16"
                                                   TextColor="{StaticResource AppPrimaryText}"
                                                   VerticalTextAlignment="Center">
                                                <Label.Style>
                                                    <Style TargetType="Label">
                                                        <Setter Property="FontFamily" Value="OpenSansRegular" />
                                                        <Style.Triggers>
                                                            <DataTrigger TargetType="Label"
                                                                         Binding="{Binding IsSelected}"
                                                                         Value="True">
                                                                <Setter Property="FontFamily" Value="OpenSans-Semibold" />
                                                                <Setter Property="TextColor" Value="{StaticResource AppSelectedAnswer}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Label.Style>
                                            </Label>
                                        </HorizontalStackLayout>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectAnswerCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Navigation Buttons -->
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                        <Button Text="QUAY LẠI"
                                Grid.Column="0"
                                BackgroundColor="{StaticResource AppSurfaceMuted}"
                                TextColor="{StaticResource AppBrand}"
                                FontFamily="OpenSans-Semibold"
                                CornerRadius="28"
                                HeightRequest="56"
                                Command="{Binding PreviousQuestionCommand}" />
                        <Button Text="TIẾP THEO"
                                Grid.Column="1"
                                BackgroundColor="{StaticResource AppBrandAccent}"
                                TextColor="{StaticResource AppPrimaryText}"
                                FontFamily="OpenSans-Semibold"
                                CornerRadius="28"
                                HeightRequest="56"
                                Command="{Binding NextQuestionCommand}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Question List -->
                <Border Style="{StaticResource AppMutedCard}"
                        Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Danh sách câu"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="18"
                                   TextColor="{StaticResource AppPrimaryText}" />
                            <Border Grid.Column="1"
                                    Padding="10,6"
                                    BackgroundColor="#DAE1E3"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999">
                                <Label Text="{Binding AnsweredQuestionsText}"
                                       FontFamily="OpenSans-Semibold"
                                       FontSize="10"
                                       TextColor="#5D6466" />
                            </Border>
                        </Grid>

                        <!-- Question Grid -->
                        <FlexLayout BindableLayout.ItemsSource="{Binding CurrentExam.Questions}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="SpaceBetween">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Question">
                                    <Border Padding="0"
                                            Margin="0,0,10,10"
                                            StrokeShape="RoundRectangle 14"
                                            HeightRequest="44"
                                            WidthRequest="60">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BackgroundColor" Value="#E5E2DB" />
                                                <Setter Property="StrokeThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsAnswered}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource AppSelectedAnswerLight}" />
                                                        <Setter Property="Stroke" Value="{StaticResource AppSelectedAnswer}" />
                                                        <Setter Property="StrokeThickness" Value="1.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Label Text="{Binding Number}"
                                               FontFamily="OpenSans-Semibold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="TextColor" Value="#7A6C56" />
                                                    <Style.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsAnswered}"
                                                                     Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource AppSelectedAnswer}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectQuestionCommand}"
                                                                  CommandParameter="{Binding Number}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Button Text="NỘP BÀI THI"
                                BackgroundColor="{StaticResource AppPrimaryText}"
                                TextColor="{StaticResource AppPageBackground}"
                                FontFamily="OpenSans-Semibold"
                                CornerRadius="18"
                                HeightRequest="54"
                                Command="{Binding SubmitExamCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Navigation -->
        <Border Grid.Row="2"
                Style="{StaticResource AppBottomBar}"
                Shadow="0,-8,24,#0A000000">
            <Grid ColumnDefinitions="*,*,*,*,*"
                  ColumnSpacing="4">
                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="⌂"
                           FontSize="18"
                           TextColor="{StaticResource AppSecondaryText}"
                           HorizontalOptions="Center" />
                    <Label Text="Trang chủ"
                           FontSize="11"
                           TextColor="{StaticResource AppSecondaryText}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Border Padding="12,8"
                            BackgroundColor="{StaticResource AppSurfaceAccent}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22">
                        <Label Text="🧪"
                               FontSize="18"
                               TextColor="{StaticResource AppPrimaryText}"
                               HorizontalOptions="Center" />
                    </Border>
                    <Label Text="Thi thử"
                           FontSize="11"
                           TextColor="{StaticResource AppBrand}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="📚"
                           FontSize="18"
                           TextColor="{StaticResource AppSecondaryText}"
                           HorizontalOptions="Center" />
                    <Label Text="Ôn tập"
                           FontSize="11"
                           TextColor="{StaticResource AppSecondaryText}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPracticeTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="📅"
                           FontSize="18"
                           TextColor="{StaticResource AppSecondaryText}"
                           HorizontalOptions="Center" />
                    <Label Text="Lịch học"
                           FontSize="11"
                           TextColor="{StaticResource AppSecondaryText}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="👤"
                           FontSize="18"
                           TextColor="{StaticResource AppSecondaryText}"
                           HorizontalOptions="Center" />
                    <Label Text="Cá nhân"
                           FontSize="11"
                           TextColor="{StaticResource AppSecondaryText}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
