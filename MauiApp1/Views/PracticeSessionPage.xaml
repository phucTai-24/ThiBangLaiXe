<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             xmlns:models="clr-namespace:MauiApp1.Models"
             x:Class="MauiApp1.Views.PracticeSessionPage"
             x:DataType="vm:PracticeSessionViewModel"
             Style="{StaticResource AppPageStyle}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Style="{StaticResource AppHeaderContainer}"
                Shadow="0,8,20,#12000000">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Style="{StaticResource AppHeaderGrid}">
                    <Border Style="{StaticResource AppIconButtonCard}">
                        <Label Text="←"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoPracticeHomeCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="ONTHIBANGLAI"
                           Style="{StaticResource AppHeaderBrandLabel}" />
                    <Label Text="Phiên ôn tập"
                           Style="{StaticResource AppHeaderTitleLabel}" />
                </VerticalStackLayout>

                <Label Grid.Column="2"
                       Text="MOCK"
                       Style="{StaticResource AppHeaderTrailingLabel}" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,18,24,140"
                                 Spacing="20">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="10">
                        <Label Text="{Binding CurrentQuestionText}"
                               FontFamily="OpenSans-Semibold"
                               FontSize="28"
                               FontAttributes="Italic"
                               TextColor="{StaticResource AppPrimaryText}" />
                        <Label Grid.Column="1"
                               Text="{Binding AnsweredQuestionsText}"
                               FontFamily="OpenSans-Semibold"
                               FontSize="11"
                               TextColor="{StaticResource AppBrand}"
                               VerticalOptions="End" />
                        <Label Grid.Column="2"
                               Text="{Binding CorrectQuestionsText}"
                               FontFamily="OpenSans-Semibold"
                               FontSize="11"
                               TextColor="{StaticResource AppSuccess}"
                               VerticalOptions="End" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="18"
                                     IsVisible="{Binding CurrentQuestion, Converter={StaticResource IsNotNullConverter}}">
                    <Border Style="{StaticResource AppMutedCard}"
                            Padding="22">
                        <VerticalStackLayout Spacing="18">
                            <HorizontalStackLayout Spacing="8">
                                <Border Padding="8,4"
                                        BackgroundColor="#FFF1D6"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="{Binding CurrentQuestion.Category}"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="10"
                                           TextColor="{StaticResource AppBrand}" />
                                </Border>
                                <Border Padding="8,4"
                                        BackgroundColor="#FCE4EC"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        IsVisible="{Binding CurrentQuestion.IsCritical}">
                                    <Label Text="Điểm liệt"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="10"
                                           TextColor="#C2185B" />
                                </Border>
                            </HorizontalStackLayout>

                            <Label Text="{Binding CurrentQuestion.Text}"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="22"
                                   LineHeight="1.3"
                                   TextColor="{StaticResource AppPrimaryText}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentQuestion.Answers}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:PracticeAnswerOption">
                                        <Border Padding="16"
                                                Margin="0,0,0,12"
                                                StrokeShape="RoundRectangle 18">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource AppSurface}" />
                                                    <Setter Property="StrokeThickness" Value="0" />
                                                    <Style.Triggers>
                                                        <MultiTrigger TargetType="Border">
                                                            <MultiTrigger.Conditions>
                                                                <BindingCondition Binding="{Binding IsRevealed}" Value="True" />
                                                                <BindingCondition Binding="{Binding IsCorrectAnswer}" Value="True" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="BackgroundColor" Value="#E8F6EA" />
                                                            <Setter Property="Stroke" Value="{StaticResource AppSuccess}" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                        </MultiTrigger>
                                                        <MultiTrigger TargetType="Border">
                                                            <MultiTrigger.Conditions>
                                                                <BindingCondition Binding="{Binding IsRevealed}" Value="True" />
                                                                <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                                <BindingCondition Binding="{Binding IsCorrectAnswer}" Value="False" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="BackgroundColor" Value="#FDECEC" />
                                                            <Setter Property="Stroke" Value="#D32F2F" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                        </MultiTrigger>
                                                        <MultiTrigger TargetType="Border">
                                                            <MultiTrigger.Conditions>
                                                                <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                                                                <BindingCondition Binding="{Binding IsRevealed}" Value="False" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter Property="BackgroundColor" Value="{StaticResource AppSelectedAnswerLight}" />
                                                            <Setter Property="Stroke" Value="{StaticResource AppSelectedAnswer}" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                        </MultiTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <HorizontalStackLayout Spacing="14">
                                                <Border WidthRequest="40"
                                                        HeightRequest="40"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 20"
                                                        BackgroundColor="{StaticResource AppSurfaceMuted}">
                                                    <Label Text="{Binding Label}"
                                                           FontFamily="OpenSans-Semibold"
                                                           FontSize="16"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center" />
                                                </Border>

                                                <Label Text="{Binding Text}"
                                                       FontSize="16"
                                                       VerticalTextAlignment="Center"
                                                       TextColor="{StaticResource AppPrimaryText}" />
                                            </HorizontalStackLayout>

                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectAnswerCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>

                            <Border BackgroundColor="#FFF8E8"
                                    Padding="14"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18"
                                    IsVisible="{Binding CurrentQuestion.IsAnswered}">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Giải thích mock"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="13"
                                           TextColor="{StaticResource AppBrand}" />
                                    <Label Text="{Binding CurrentQuestion.Explanation}"
                                           FontSize="13"
                                           LineHeight="1.3"
                                           TextColor="#5F564B" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="14">
                        <Button Text="QUAY LẠI"
                                Grid.Column="0"
                                BackgroundColor="{StaticResource AppSurfaceMuted}"
                                TextColor="{StaticResource AppBrand}"
                                FontFamily="OpenSans-Semibold"
                                CornerRadius="28"
                                HeightRequest="56"
                                Command="{Binding PreviousQuestionCommand}" />
                        <Button Text="TIẾP THEO"
                                Grid.Column="1"
                                BackgroundColor="{StaticResource AppBrandAccent}"
                                TextColor="{StaticResource AppPrimaryText}"
                                FontFamily="OpenSans-Semibold"
                                CornerRadius="28"
                                HeightRequest="56"
                                Command="{Binding NextQuestionCommand}" />
                    </Grid>
                </VerticalStackLayout>

                <Border Style="{StaticResource AppMutedCard}"
                        Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Danh sách câu"
                               FontFamily="OpenSans-Semibold"
                               FontSize="18" />

                        <FlexLayout BindableLayout.ItemsSource="{Binding Questions}"
                                    Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="SpaceBetween">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:PracticeQuestionItem">
                                    <Border Padding="0"
                                            Margin="0,0,10,10"
                                            StrokeShape="RoundRectangle 14"
                                            HeightRequest="44"
                                            WidthRequest="60">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BackgroundColor" Value="#E5E2DB" />
                                                <Setter Property="StrokeThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsCurrent}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="#FFF1D6" />
                                                        <Setter Property="Stroke" Value="{StaticResource AppBrand}" />
                                                        <Setter Property="StrokeThickness" Value="1.5" />
                                                    </DataTrigger>
                                                    <MultiTrigger TargetType="Border">
                                                        <MultiTrigger.Conditions>
                                                            <BindingCondition Binding="{Binding IsAnswered}" Value="True" />
                                                            <BindingCondition Binding="{Binding IsCorrectlyAnswered}" Value="True" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter Property="BackgroundColor" Value="#E8F6EA" />
                                                        <Setter Property="Stroke" Value="{StaticResource AppSuccess}" />
                                                        <Setter Property="StrokeThickness" Value="1.5" />
                                                    </MultiTrigger>
                                                    <MultiTrigger TargetType="Border">
                                                        <MultiTrigger.Conditions>
                                                            <BindingCondition Binding="{Binding IsAnswered}" Value="True" />
                                                            <BindingCondition Binding="{Binding IsCorrectlyAnswered}" Value="False" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter Property="BackgroundColor" Value="#FDECEC" />
                                                        <Setter Property="Stroke" Value="#D32F2F" />
                                                        <Setter Property="StrokeThickness" Value="1.5" />
                                                    </MultiTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Label Text="{Binding Number}"
                                               FontFamily="OpenSans-Semibold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectQuestionCommand}"
                                                                  CommandParameter="{Binding Number}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <Button Text="NỘP PHIÊN ÔN TẬP"
                                BackgroundColor="{StaticResource AppPrimaryText}"
                                TextColor="{StaticResource AppPageBackground}"
                                FontFamily="OpenSans-Semibold"
                                CornerRadius="18"
                                HeightRequest="54"
                                Command="{Binding SubmitPracticeCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                Style="{StaticResource AppBottomBar}"
                Shadow="0,-8,24,#0A000000">
            <Grid ColumnDefinitions="*,*,*,*,*"
                  ColumnSpacing="4">
                <VerticalStackLayout Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="⌂"
                           FontSize="18"
                           TextColor="{StaticResource AppSecondaryText}"
                           HorizontalOptions="Center" />
                    <Label Text="Trang chủ"
                           FontSize="11"
                           TextColor="{StaticResource AppSecondaryText}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoHomeCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="🧪"
                           FontSize="18"
                           TextColor="{StaticResource AppSecondaryText}"
                           HorizontalOptions="Center" />
                    <Label Text="Thi thử"
                           FontSize="11"
                           TextColor="{StaticResource AppSecondaryText}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoMockExamCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Border Padding="12,8"
                            BackgroundColor="{StaticResource AppSurfaceAccent}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22">
                        <Label Text="📚"
                               FontSize="18"
                               TextColor="{StaticResource AppPrimaryText}"
                               HorizontalOptions="Center" />
                    </Border>
                    <Label Text="Ôn tập"
                           FontSize="11"
                           TextColor="{StaticResource AppBrand}" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoPracticeHomeCommand}" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="3"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="📅"
                           FontSize="18"
                           TextColor="{StaticResource AppSecondaryText}"
                           HorizontalOptions="Center" />
                    <Label Text="Lịch học"
                           FontSize="11"
                           TextColor="{StaticResource AppSecondaryText}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="4"
                                     Spacing="4"
                                     HorizontalOptions="Center">
                    <Label Text="👤"
                           FontSize="18"
                           TextColor="{StaticResource AppSecondaryText}"
                           HorizontalOptions="Center" />
                    <Label Text="Cá nhân"
                           FontSize="11"
                           TextColor="{StaticResource AppSecondaryText}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>

</ContentPage>
