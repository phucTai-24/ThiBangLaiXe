<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <Color x:Key="AppPageBackground">#FCF9F2</Color>
    <Color x:Key="AppSurface">#FFFFFF</Color>
    <Color x:Key="AppSurfaceMuted">#F6F3EC</Color>
    <Color x:Key="AppSurfaceAccent">#FFF0C7</Color>
    <Color x:Key="AppPrimaryText">#271900</Color>
    <Color x:Key="AppSecondaryText">#5F564B</Color>
    <Color x:Key="AppTertiaryText">#7E7468</Color>
    <Color x:Key="AppBrand">#7C5800</Color>
    <Color x:Key="AppBrandStrong">#271900</Color>
    <Color x:Key="AppBrandAccent">#FFB800</Color>
    <Color x:Key="AppBorder">#14D5C4AB</Color>
    <Color x:Key="AppSuccess">#2E7D32</Color>
    <Color x:Key="AppDanger">#BA1A1A</Color>
    <Color x:Key="AppSelectedAnswer">#4CAF50</Color>
    <Color x:Key="AppSelectedAnswerLight">#E8F5E9</Color>

    <x:Double x:Key="AppSpacingXs">8</x:Double>
    <x:Double x:Key="AppSpacingSm">12</x:Double>
    <x:Double x:Key="AppSpacingMd">16</x:Double>
    <x:Double x:Key="AppSpacingLg">24</x:Double>
    <x:Double x:Key="AppSpacingXl">32</x:Double>

    <Thickness x:Key="PagePadding">24,24,24,140</Thickness>
    <Thickness x:Key="SectionPadding">22</Thickness>
    <Thickness x:Key="CardPadding">18</Thickness>
    <Thickness x:Key="HeaderPadding">24,18</Thickness>

    <CornerRadius x:Key="RadiusSm">16</CornerRadius>
    <CornerRadius x:Key="RadiusMd">22</CornerRadius>
    <CornerRadius x:Key="RadiusLg">24</CornerRadius>
    <CornerRadius x:Key="RadiusXl">28</CornerRadius>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
    <SolidColorBrush x:Key="AppPageBackgroundBrush" Color="{StaticResource AppPageBackground}"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="{StaticResource AppSurface}"/>
    <SolidColorBrush x:Key="AppSurfaceMutedBrush" Color="{StaticResource AppSurfaceMuted}"/>
    <SolidColorBrush x:Key="AppSurfaceAccentBrush" Color="{StaticResource AppSurfaceAccent}"/>
    <SolidColorBrush x:Key="AppBrandBrush" Color="{StaticResource AppBrand}"/>
    <SolidColorBrush x:Key="AppBrandAccentBrush" Color="{StaticResource AppBrandAccent}"/>
</ResourceDictionary>
