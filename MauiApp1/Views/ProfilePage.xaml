<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.ProfilePage"
             Style="{StaticResource AppPageStyle}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Style="{StaticResource AppHeaderContainer}"
                Shadow="0,8,20,#12000000">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Style="{StaticResource AppHeaderGrid}">
                <Border Style="{StaticResource AppIconButtonCard}"
                        VerticalOptions="Center">
                    <Label Text="👤"
                           FontSize="18"
                           TextColor="{StaticResource AppPrimaryText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="ONTHIBANGLAI"
                           Style="{StaticResource AppHeaderBrandLabel}" />
                    <Label Text="Hồ sơ cá nhân"
                           Style="{StaticResource AppHeaderTitleLabel}" />
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        Style="{StaticResource AppIconButtonCard}"
                        VerticalOptions="Center">
                    <Label Text="✎"
                           FontSize="18"
                           TextColor="{StaticResource AppSecondaryText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,24,24,140"
                                 Spacing="22">
                <Border Style="{StaticResource AppAccentCard}"
                        Padding="24"
                        Shadow="0,12,28,#14FFB800">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="16">
                            <Border WidthRequest="88"
                                    HeightRequest="88"
                                    BackgroundColor="#FFF8E8"
                                    Stroke="#2AFFFFFF"
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 28">
                                <Label Text="👨"
                                       FontSize="42"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="6"
                                                 VerticalOptions="Center">
                                <Label x:Name="FullNameLabel"
                                       Text="Đang tải..."
                                       Style="{StaticResource AppSectionTitle}"
                                       FontSize="28" />
                                <Label x:Name="RoleStatusLabel"
                                       Text="Đang tải hồ sơ người dùng"
                                       Style="{StaticResource AppBodyLabel}"
                                       TextColor="{StaticResource AppBrandStrong}" />
                                <Label x:Name="ProfileSourceLabel"
                                       Text="Nguồn dữ liệu hồ sơ: đang kiểm tra"
                                       Style="{StaticResource AppCaptionLabel}"
                                       TextColor="#F5E4B7" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <Border BackgroundColor="#FFF3DC"
                                    Padding="14"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Khóa học hiện tại"
                                           Style="{StaticResource AppCaptionLabel}" />
                                    <Label Text="B2 - Tháng 4/2026"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="16"
                                           TextColor="{StaticResource AppBrandStrong}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="#E8F6EA"
                                    Padding="14"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Trạng thái hồ sơ"
                                           Style="{StaticResource AppCaptionLabel}" />
                                    <Label x:Name="ProfileStatusLabel"
                                           Text="Đang tải"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="16"
                                           TextColor="{StaticResource AppSuccess}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Border BackgroundColor="{StaticResource AppBrandAccent}"
                                Padding="16,14"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Chỉnh sửa hồ sơ"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="16"
                                           TextColor="{StaticResource AppBrandStrong}" />
                                    <Label Text="Nút này là điểm gắn API cập nhật hồ sơ sau này theo [`PUT /api/students/me`](Demo.docx)."
                                           Style="{StaticResource AppCaptionLabel}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="1"
                                        BackgroundColor="#271900"
                                        Padding="14,10"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999"
                                        VerticalOptions="Center">
                                    <Label Text="Sửa ngay"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="13"
                                           TextColor="#FFF8E8" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEditTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="14">
                    <Label Text="Thông tin cá nhân"
                           Style="{StaticResource AppSectionTitle}" />

                    <Border Style="{StaticResource AppCard}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Border WidthRequest="50"
                                    HeightRequest="50"
                                    BackgroundColor="#FFF3DC"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <Label Text="📱"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                <Label Text="Số điện thoại"
                                       Style="{StaticResource AppCaptionLabel}" />
                                <Label x:Name="PhoneLabel"
                                       Text="Đang tải..."
                                       Style="{StaticResource AppCardTitle}" />
                                <Label Text="Thông tin dùng cho đăng nhập, xác minh và liên hệ học vụ."
                                       Style="{StaticResource AppCaptionLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AppCard}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Border WidthRequest="50"
                                    HeightRequest="50"
                                    BackgroundColor="#EAF4FF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <Label Text="✉️"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                <Label Text="Email"
                                       Style="{StaticResource AppCaptionLabel}" />
                                <Label x:Name="EmailLabel"
                                       Text="Đang tải..."
                                       Style="{StaticResource AppCardTitle}" />
                                <Label Text="Email nhận thông báo học tập, lịch thi và xác nhận hồ sơ."
                                       Style="{StaticResource AppCaptionLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AppCard}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Border WidthRequest="50"
                                    HeightRequest="50"
                                    BackgroundColor="#F6E8FB"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <Label Text="🪪"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                <Label Text="CCCD &amp; ngày sinh"
                                       Style="{StaticResource AppCaptionLabel}" />
                                <Label x:Name="IdentityLabel"
                                       Text="Đang tải..."
                                       Style="{StaticResource AppCardTitle}" />
                                <Label Text="Nhóm dữ liệu đối chiếu hồ sơ học viên và danh sách dự thi."
                                       Style="{StaticResource AppCaptionLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AppCard}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="14">
                            <Border WidthRequest="50"
                                    HeightRequest="50"
                                    BackgroundColor="#E8F6EA"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <Label Text="📍"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                <Label Text="Địa chỉ hiện tại"
                                       Style="{StaticResource AppCaptionLabel}" />
                                <Label x:Name="AddressLabel"
                                       Text="Đang tải..."
                                       Style="{StaticResource AppCardTitle}" />
                                <Label Text="Địa chỉ liên hệ để làm hồ sơ, nhận nhắc lịch và đối soát thông tin."
                                       Style="{StaticResource AppCaptionLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="14">
                    <Label Text="Tổng quan học tập"
                           Style="{StaticResource AppSectionTitle}" />

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="SpaceBetween"
                                AlignItems="Stretch">
                        <Border Style="{StaticResource AppCard}"
                                FlexLayout.Basis="48%"
                                FlexLayout.Grow="1">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="📚"
                                       FontSize="24" />
                                <Label Text="Tiến độ học"
                                       Style="{StaticResource AppCardTitle}" />
                                <Label Text="12/30 buổi"
                                       FontFamily="OpenSans-Semibold"
                                       FontSize="18"
                                       TextColor="{StaticResource AppBrand}" />
                                <Label Text="Tương ứng 40% khóa học hiện tại"
                                       Style="{StaticResource AppCaptionLabel}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource AppCard}"
                                FlexLayout.Basis="48%"
                                FlexLayout.Grow="1">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="✅"
                                       FontSize="24" />
                                <Label Text="Điểm danh"
                                       Style="{StaticResource AppCardTitle}" />
                                <Label Text="91.7%"
                                       FontFamily="OpenSans-Semibold"
                                       FontSize="18"
                                       TextColor="{StaticResource AppSuccess}" />
                                <Label Text="Tỷ lệ có mặt hiện tại của học viên"
                                       Style="{StaticResource AppCaptionLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>

                <Button x:Name="LogoutButton"
                        Text="Đăng xuất"
                        HeightRequest="54"
                        CornerRadius="27"
                        BackgroundColor="#2E2A25"
                        TextColor="White"
                        FontFamily="OpenSans-Semibold"
                        FontSize="16"
                        Clicked="OnLogoutClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNavView Grid.Row="2"
                                   CurrentTab="profile" />

        <controls:ChatOverlayView Grid.RowSpan="3" />
    </Grid>

</ContentPage>
