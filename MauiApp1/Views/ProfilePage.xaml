<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.ProfilePage"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Style="{StaticResource AppHeaderContainer}"
                BackgroundColor="#FFFFFF"
                Shadow="0,8,20,#0D000000">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#F0ECFF"
                            StrokeThickness="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="RoundRectangle 16">
                        <Label Text="👤"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="ONTHIBANGLAI"
                               FontFamily="OpenSans-Semibold"
                               FontSize="10"
                               CharacterSpacing="2"
                               TextColor="#999999" />
                        <Label Text="Hồ sơ cá nhân"
                               FontFamily="OpenSans-Semibold"
                               FontSize="20"
                               TextColor="#222222" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border Grid.Column="1"
                        Style="{StaticResource AppIconButtonCard}">
                    <Label Text="✎"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEditTapped" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,24,24,140"
                                 Spacing="22">

                <Border BackgroundColor="#FFFFFF"
                        Padding="22"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28"
                        Shadow="0,12,28,#12000000">
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="16">
                            <Border WidthRequest="78"
                                    HeightRequest="78"
                                    BackgroundColor="#F0ECFF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24">
                                <Label Text="👨"
                                       FontSize="38"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="5"
                                                 VerticalOptions="Center">
                                <Label x:Name="FullNameLabel"
                                       Text="Đang tải..."
                                       FontFamily="OpenSans-Semibold"
                                       FontSize="26"
                                       TextColor="#222222"
                                       LineBreakMode="TailTruncation" />
                                <Label x:Name="RoleStatusLabel"
                                       Text="Đang tải hồ sơ người dùng"
                                       FontSize="13"
                                       TextColor="#5B4AE6"
                                       LineBreakMode="TailTruncation" />
                                <Label x:Name="ProfileSourceLabel"
                                       Text="Nguồn dữ liệu hồ sơ: đang kiểm tra"
                                       FontSize="12"
                                       TextColor="#999999"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">
                            <Border BackgroundColor="#F0ECFF"
                                    Padding="14"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Khóa học"
                                           FontSize="12"
                                           TextColor="#999999" />
                                    <Label Text="B2 - Tháng 4/2026"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="15"
                                           TextColor="#5B4AE6" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1"
                                    BackgroundColor="#E8F6EA"
                                    Padding="14"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Trạng thái"
                                           FontSize="12"
                                           TextColor="#999999" />
                                    <Label x:Name="ProfileStatusLabel"
                                           Text="Đang tải"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="15"
                                           TextColor="#2E7D32" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="14">
                    <Label Text="Thông tin cá nhân"
                           FontFamily="OpenSans-Semibold"
                           FontSize="22"
                           TextColor="#222222" />

                    <Border BackgroundColor="#FFFFFF"
                            Padding="18"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24"
                            Shadow="0,10,24,#0F000000">
                        <VerticalStackLayout Spacing="18">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14">
                                <Border WidthRequest="46"
                                        HeightRequest="46"
                                        BackgroundColor="#F0ECFF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16">
                                    <Label Text="📱"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3">
                                    <Label Text="Số điện thoại"
                                           FontSize="12"
                                           TextColor="#999999" />
                                    <Label x:Name="PhoneLabel"
                                           Text="Đang tải..."
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="16"
                                           TextColor="#222222" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="#F0F0F0" />

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14">
                                <Border WidthRequest="46"
                                        HeightRequest="46"
                                        BackgroundColor="#EAF4FF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16">
                                    <Label Text="✉️"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3">
                                    <Label Text="Email"
                                           FontSize="12"
                                           TextColor="#999999" />
                                    <Label x:Name="EmailLabel"
                                           Text="Đang tải..."
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="16"
                                           TextColor="#222222"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="#F0F0F0" />

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14">
                                <Border WidthRequest="46"
                                        HeightRequest="46"
                                        BackgroundColor="#F6E8FB"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16">
                                    <Label Text="🪪"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3">
                                    <Label Text="CCCD &amp; ngày sinh"
                                           FontSize="12"
                                           TextColor="#999999" />
                                    <Label x:Name="IdentityLabel"
                                           Text="Đang tải..."
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="16"
                                           TextColor="#222222" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="#F0F0F0" />

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14">
                                <Border WidthRequest="46"
                                        HeightRequest="46"
                                        BackgroundColor="#E8F6EA"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16">
                                    <Label Text="📍"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="3">
                                    <Label Text="Địa chỉ hiện tại"
                                           FontSize="12"
                                           TextColor="#999999" />
                                    <Label x:Name="AddressLabel"
                                           Text="Đang tải..."
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="16"
                                           TextColor="#222222"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="12">
                    <Border BackgroundColor="#FFFFFF"
                            Padding="18"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 24"
                            Shadow="0,10,24,#0F000000">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14">
                            <Border WidthRequest="46"
                                    HeightRequest="46"
                                    BackgroundColor="#F0ECFF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16">
                                <Label Text="⚙️"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="Cài đặt"
                                       FontFamily="OpenSans-Semibold"
                                       FontSize="16"
                                       TextColor="#222222" />
                                <Label Text="Cấu hình ứng dụng và API"
                                       FontSize="12"
                                       TextColor="#999999" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2"
                                   Text="›"
                                   FontSize="26"
                                   TextColor="#999999"
                                   VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <Button x:Name="LogoutButton"
                            Text="Đăng xuất"
                            HeightRequest="54"
                            CornerRadius="27"
                            BackgroundColor="#222222"
                            TextColor="White"
                            FontFamily="OpenSans-Semibold"
                            FontSize="16"
                            Clicked="OnLogoutClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNavView Grid.Row="2"
                                   CurrentTab="profile" />

        <controls:ChatOverlayView Grid.RowSpan="3" />
    </Grid>

</ContentPage>
