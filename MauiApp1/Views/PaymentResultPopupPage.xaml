<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.PaymentResultPopupPage"
             BackgroundColor="#66000000"
             Shell.NavBarIsVisible="False">
    <Grid Padding="20">
        <Border BackgroundColor="White"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Padding="18"
                VerticalOptions="Center"
                HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Frame Grid.Column="0" BackgroundColor="#DCFCE7" CornerRadius="20" Padding="8" HasShadow="False" HeightRequest="40" WidthRequest="40">
                        <Label Text="✓" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#16A34A" FontSize="20" FontAttributes="Bold"/>
                    </Frame>
                    <Label Grid.Column="1" Text="Kết quả thanh toán" FontSize="18" FontAttributes="Bold" VerticalTextAlignment="Center" Margin="10,0,0,0" />
                    <Button Grid.Column="2" Text="✕" Clicked="OnCloseClicked" BackgroundColor="Transparent" TextColor="#64748B" FontSize="18" Padding="0" WidthRequest="32" HeightRequest="32"/>
                </Grid>

                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding StatusTitle}" FontAttributes="Bold" TextColor="#0F172A" FontSize="16"/>
                        <Label Text="{Binding AmountText}" TextColor="#16A34A" FontAttributes="Bold" FontSize="22"/>
                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4"/>
                        <Label Text="{Binding CourseText}" TextColor="#334155" FontSize="14"/>
                        <Label Text="{Binding ClassText}" TextColor="#334155" FontSize="14"/>
                        <Label Text="{Binding DetailText}" TextColor="#64748B" FontSize="13"/>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Đóng" Clicked="OnCloseClicked" BackgroundColor="#4F46E5" TextColor="White" CornerRadius="12" HeightRequest="44" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
