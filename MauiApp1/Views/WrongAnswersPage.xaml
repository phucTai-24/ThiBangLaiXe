<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiApp1.ViewModels"
             xmlns:models="clr-namespace:MauiApp1.Models"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.WrongAnswersPage"
             x:DataType="viewmodels:WrongAnswersViewModel"
             Style="{StaticResource AppPageStyle}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Style="{StaticResource AppHeaderContainer}"
                Shadow="0,8,20,#12000000">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  Style="{StaticResource AppHeaderGrid}">
                <Border Style="{StaticResource AppIconButtonCard}">
                    <Label Text="←"
                           FontSize="18"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2">
                    <Label Text="ONTHIBANGLAI"
                           Style="{StaticResource AppHeaderBrandLabel}" />
                    <Label Text="Xem bài làm"
                           Style="{StaticResource AppHeaderTitleLabel}" />
                </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="{Binding Questions.Count, StringFormat='{}{0} câu sai'}"
                               Style="{StaticResource AppHeaderTrailingLabel}" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,24,24,120"
                                 Spacing="18">
                <Border Style="{StaticResource AppAccentCard}"
                        Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding PageTitle}"
                               Style="{StaticResource AppSectionTitle}" />
                        <Label Text="{Binding SummaryText}"
                               Style="{StaticResource AppBodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center" />

                <Border Style="{StaticResource AppMutedCard}"
                        Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Danh sách câu"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="18"
                                   TextColor="{StaticResource AppPrimaryText}" />
                            <Border Grid.Column="1"
                                    Padding="10,6"
                                    BackgroundColor="#DAE1E3"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999">
                                <Label Text="{Binding Questions.Count, StringFormat='{}{0} câu sai'}"
                                       FontFamily="OpenSans-Semibold"
                                       FontSize="10"
                                       TextColor="#5D6466" />
                            </Border>
                        </Grid>

                        <FlexLayout BindableLayout.ItemsSource="{Binding Questions}"
                                     Wrap="Wrap"
                                     Direction="Row"
                                     JustifyContent="SpaceBetween">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Question">
                                    <Border Padding="0"
                                            Margin="0,0,10,10"
                                            StrokeShape="RoundRectangle 14"
                                            HeightRequest="44"
                                            WidthRequest="60">
                                        <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BackgroundColor" Value="#FFF1EF" />
                                                    <Setter Property="Stroke" Value="#33BA1A1A" />
                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                </Style>
                                            </Border.Style>
                                        <Label Text="{Binding Number}"
                                               FontFamily="OpenSans-Semibold"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="#BA1A1A" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenQuestionPopupCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.RowSpan="3"
              BackgroundColor="#66000000"
              IsVisible="{Binding IsPopupOpen}">
            <Border Margin="20,80,20,80"
                    Padding="20"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    VerticalOptions="Center">
                <ScrollView>
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding SelectedQuestion.Number, StringFormat='Chi tiết câu {0}'}"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="20"
                                   TextColor="#271900" />
                            <Border Grid.Column="1"
                                    Padding="8,4"
                                    BackgroundColor="#F0EEE7"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="✕"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ClosePopupCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <Label Text="{Binding SelectedQuestion.Text}"
                               FontFamily="OpenSans-Semibold"
                               FontSize="22"
                               TextColor="#271900"
                               LineBreakMode="WordWrap" />

                        <VerticalStackLayout Spacing="12"
                                             BindableLayout.ItemsSource="{Binding SelectedQuestion.Answers}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Answer">
                                    <Border Padding="16"
                                            StrokeShape="RoundRectangle 18">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BackgroundColor" Value="#F6F3EC" />
                                                <Setter Property="StrokeThickness" Value="0" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsSelectedWrong}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="#FFF1EF" />
                                                        <Setter Property="Stroke" Value="#33BA1A1A" />
                                                        <Setter Property="StrokeThickness" Value="2" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsCorrectUnselected}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="#E8F6EA" />
                                                        <Setter Property="Stroke" Value="#332E7D32" />
                                                        <Setter Property="StrokeThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="12">
                                            <Border WidthRequest="34"
                                                    HeightRequest="34"
                                                    BackgroundColor="#FFFFFF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 17">
                                                <Label Text="{Binding Label}"
                                                       FontFamily="OpenSans-Semibold"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="4">
                                                <Label Text="{Binding Text}"
                                                       FontSize="15"
                                                       TextColor="#271900"
                                                       LineBreakMode="WordWrap" />
                                                <Label FontSize="12"
                                                       FontFamily="OpenSans-Semibold">
                                                    <Label.Style>
                                                        <Style TargetType="Label">
                                                            <Setter Property="IsVisible" Value="False" />
                                                            <Style.Triggers>
                                                                <DataTrigger TargetType="Label"
                                                                             Binding="{Binding IsSelectedWrong}"
                                                                             Value="True">
                                                                    <Setter Property="IsVisible" Value="True" />
                                                                    <Setter Property="Text" Value="Đáp án bạn đã chọn" />
                                                                    <Setter Property="TextColor" Value="#BA1A1A" />
                                                                </DataTrigger>
                                                                <DataTrigger TargetType="Label"
                                                                             Binding="{Binding IsCorrectUnselected}"
                                                                             Value="True">
                                                                    <Setter Property="IsVisible" Value="True" />
                                                                    <Setter Property="Text" Value="Đáp án đúng" />
                                                                    <Setter Property="TextColor" Value="#2E7D32" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Label.Style>
                                                </Label>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BackgroundColor="#CCFCF9F2"
                StrokeThickness="0"
                Padding="20,12">
            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="Trang chủ"
                        Command="{Binding GoHomeCommand}"
                        BackgroundColor="#F0EEE7"
                        TextColor="#271900"
                        FontFamily="OpenSans-Semibold"
                        CornerRadius="28"
                        HeightRequest="52" />
                <Button Grid.Column="1"
                        Text="Thi lại"
                        Command="{Binding RetakeExamCommand}"
                        BackgroundColor="#FFB800"
                        TextColor="#271900"
                        FontFamily="OpenSans-Semibold"
                        CornerRadius="28"
                        HeightRequest="52" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
