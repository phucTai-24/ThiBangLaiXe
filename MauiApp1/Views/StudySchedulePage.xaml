<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
              xmlns:model="clr-namespace:MauiApp1.Models"
              xmlns:controls="clr-namespace:MauiApp1.Controls"
              x:Class="MauiApp1.Views.StudySchedulePage"
              x:Name="ThisPage"
              BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Style="{StaticResource AppHeaderContainer}"
                BackgroundColor="#FFFFFF"
                Shadow="0,8,20,#0D000000">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                <HorizontalStackLayout Spacing="12">
                    <Border BackgroundColor="#F0ECFF"
                            StrokeThickness="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="RoundRectangle 16">
                        <Label Text="📅"
                               FontSize="22"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="2"
                                         VerticalOptions="Center">
                        <Label Text="ONTHIBANGLAI"
                               FontFamily="OpenSans-Semibold"
                               FontSize="10"
                               CharacterSpacing="2"
                               TextColor="#999999" />
                        <Label Text="Lịch học"
                               FontFamily="OpenSans-Semibold"
                               FontSize="20"
                               TextColor="#222222" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>

                <Border Grid.Column="1"
                        Style="{StaticResource AppIconButtonCard}"
                        VerticalOptions="Center">
                    <Label Text="🕘"
                           FontSize="18"
                           TextColor="{StaticResource AppSecondaryText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,24,24,140"
                                  Spacing="24">
                <Border BackgroundColor="#FFFFFF"
                        Padding="18"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Shadow="0,10,24,#0F000000">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="14">
                        <Border BackgroundColor="#F0ECFF"
                                WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                            <Label Text="‹"
                                   FontSize="28"
                                   TextColor="#5B4AE6"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PreviousWeekCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4"
                                             HorizontalOptions="Center">
                            <Label Text="Lịch trong tuần"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="20"
                                   TextColor="#222222"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding WeekRangeText}"
                                   FontSize="13"
                                   TextColor="#999999"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <Border Grid.Column="2"
                                BackgroundColor="#F0ECFF"
                                WidthRequest="46"
                                HeightRequest="46"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16">
                            <Label Text="›"
                                   FontSize="28"
                                   TextColor="#5B4AE6"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NextWeekCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <Border BackgroundColor="#5B4AE6"
                        Padding="14,12"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        HorizontalOptions="Start">
                    <Label Text="Về tuần hiện tại"
                           FontFamily="OpenSans-Semibold"
                           FontSize="13"
                           TextColor="#FFFFFF" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CurrentWeekCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <CollectionView ItemsSource="{Binding UpcomingItems}"
                                SelectionMode="None"
                                ItemsUpdatingScrollMode="KeepScrollOffset">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:StudyScheduleItem">
                            <Border BackgroundColor="#FFFFFF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24"
                                    Shadow="0,10,24,#0F000000"
                                    Margin="0,0,0,14"
                                    Padding="16">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="14">
                                    <Border WidthRequest="76"
                                            BackgroundColor="#F0ECFF"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 20"
                                            VerticalOptions="Fill">
                                        <VerticalStackLayout Spacing="4"
                                                             Padding="8"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding DateText}"
                                                   FontFamily="OpenSans-Semibold"
                                                   FontSize="13"
                                                   TextColor="#5B4AE6"
                                                   HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding TimeRange}"
                                                   FontSize="11"
                                                   TextColor="#999999"
                                                   HorizontalTextAlignment="Center" />
                                        </VerticalStackLayout>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="7">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <Label Text="{Binding SessionTitle}"
                                                   FontFamily="OpenSans-Semibold"
                                                   FontSize="17"
                                                   TextColor="#222222"
                                                   LineBreakMode="TailTruncation" />
                                            <Border Grid.Column="1"
                                                    BackgroundColor="{Binding StatusBackground}"
                                                    Padding="10,5"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 999">
                                                <Label Text="{Binding Status}"
                                                       FontFamily="OpenSans-Semibold"
                                                       FontSize="11"
                                                       TextColor="{Binding StatusColor}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding CourseName}"
                                               FontSize="13"
                                               TextColor="#666666"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Location}"
                                               FontFamily="OpenSans-Semibold"
                                               FontSize="14"
                                               TextColor="#2F80ED"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding WeekdayText}"
                                               FontSize="12"
                                               TextColor="#999999" />

                                        <Border BackgroundColor="#5B4AE6"
                                                Padding="12,8"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 999"
                                                HorizontalOptions="Start"
                                                Margin="0,4,0,0">
                                            <Label Text="Xem chi tiết"
                                                   FontFamily="OpenSans-Semibold"
                                                   FontSize="12"
                                                   TextColor="#FFFFFF" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnScheduleDetailTapped" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNavView Grid.Row="2"
                                   CurrentTab="schedule" />

        <controls:ChatOverlayView Grid.RowSpan="3" />
    </Grid>
</ContentPage>
