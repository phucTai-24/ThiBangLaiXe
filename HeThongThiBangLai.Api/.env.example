# ==========================================
# HeThongThiBangLai.Api - ENV SAMPLE
# Khong commit gia tri that vao git
# ==========================================

# ASP.NET
ASPNETCORE_ENVIRONMENT=Development

# SQL Server connection string cho .NET (double underscore)
# LUU Y: neu password co ky tu # thi phai boc toan bo value bang dau "..."
# Truong hop dang dung hien tai (remote TCP server):
ConnectionStrings__DefaultConnection="Server=tcp:192.168.1.3,51433;Database=he_thong_thi_bang_lai;User Id=tblx_app;Password=REPLACE_WITH_APP_LOGIN_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True;"

# Tham khao 1: default instance localhost
# ConnectionStrings__DefaultConnection=Server=localhost;Database=he_thong_thi_bang_lai;User Id=tblx_app;Password=REPLACE_WITH_APP_LOGIN_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True;

# Tham khao 2: named instance localhost\THIBANGLAIXE
# ConnectionStrings__DefaultConnection=Server=localhost\THIBANGLAIXE;Database=he_thong_thi_bang_lai;User Id=tblx_app;Password=REPLACE_WITH_APP_LOGIN_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=True;

# JWT
Jwt__Issuer=HeThongThiBangLai.Api
Jwt__Audience=HeThongThiBangLai.Client
Jwt__SecretKey=REPLACE_WITH_A_LONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
Jwt__ExpirationMinutes=480

# Reset password settings
ResetPassword__ExpirationMinutes=30
ResetPassword__FrontendResetUrl=http://localhost:3000/reset-password

# External APIs (neu co)
ThirdParty__Sms__BaseUrl=
ThirdParty__Sms__ApiKey=
ThirdParty__Mail__ApiKey=
ThirdParty__Storage__AccessKey=
ThirdParty__Storage__SecretKey=
