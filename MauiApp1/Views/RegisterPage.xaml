<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.RegisterPage"
             Style="{StaticResource AppPageStyle}">

    <ContentPage.Resources>
        <Style x:Key="RegisterFieldLabelStyle" TargetType="Label" BasedOn="{StaticResource AppCaptionLabel}">
            <Setter Property="FontFamily" Value="OpenSans-Semibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource AppSecondaryText}" />
            <Setter Property="CharacterSpacing" Value="0.3" />
        </Style>

        <Style x:Key="RegisterFieldBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource AppSurface}" />
            <Setter Property="Stroke" Value="{StaticResource AppBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14,8" />
        </Style>

        <Style x:Key="RegisterEntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource AppPrimaryText}" />
            <Setter Property="PlaceholderColor" Value="{StaticResource AppTertiaryText}" />
            <Setter Property="FontFamily" Value="OpenSans-Regular" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinimumHeightRequest" Value="40" />
        </Style>

        <Style x:Key="PasswordEntryStyle" TargetType="Entry" BasedOn="{StaticResource RegisterEntryStyle}">
            <Setter Property="FontFamily" Value="OpenSans-Regular" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CharacterSpacing" Value="0" />
        </Style>

        <Style x:Key="IconLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource AppSecondaryText}" />
        </Style>

        <Style x:Key="PasswordToggleChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BackgroundColor" Value="{StaticResource AppSurfaceMuted}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BackgroundColor="#FFF7DD"
                StrokeThickness="0"
                Padding="20,16,20,22">
            <VerticalStackLayout Spacing="12">
                <Button Text="←"
                        WidthRequest="40"
                        HeightRequest="40"
                        CornerRadius="14"
                        BackgroundColor="{StaticResource AppSurface}"
                        BorderColor="{StaticResource AppBorder}"
                        BorderWidth="1"
                        TextColor="{StaticResource AppPrimaryText}"
                        FontSize="18"
                        HorizontalOptions="Start"
                        Clicked="OnBackClicked" />

                <VerticalStackLayout Spacing="2">
                    <Label Text="Tạo tài khoản"
                           Style="{StaticResource AppSectionTitle}"
                           FontSize="30" />
                    <Label Text="Tạo hồ sơ nhanh chóng để bắt đầu học và ôn thi hiệu quả."
                           Style="{StaticResource AppBodyLabel}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16,20,30" Spacing="18">
                <Border BackgroundColor="{StaticResource AppSurface}"
                        Stroke="{StaticResource AppBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28"
                        Padding="18"
                        Shadow="0,10,24,#14000000">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Họ và tên" Style="{StaticResource RegisterFieldLabelStyle}" />
                            <Border x:Name="FullNameBorder" Style="{StaticResource RegisterFieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="👤" Style="{StaticResource IconLabelStyle}" />
                                    <Entry x:Name="FullNameEntry" Grid.Column="1" Placeholder="Nguyễn Văn A" Style="{StaticResource RegisterEntryStyle}" />
                                </Grid>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference FullNameEntry}, Path=IsFocused}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource AppBrand}" />
                                        <Setter Property="StrokeThickness" Value="1.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Số điện thoại" Style="{StaticResource RegisterFieldLabelStyle}" />
                            <Border x:Name="PhoneBorder" Style="{StaticResource RegisterFieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="📱" Style="{StaticResource IconLabelStyle}" />
                                    <Entry x:Name="PhoneEntry" Grid.Column="1" Placeholder="090 123 4567" Keyboard="Telephone" Style="{StaticResource RegisterEntryStyle}" />
                                </Grid>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference PhoneEntry}, Path=IsFocused}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource AppBrand}" />
                                        <Setter Property="StrokeThickness" Value="1.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Email" Style="{StaticResource RegisterFieldLabelStyle}" />
                            <Border x:Name="EmailBorder" Style="{StaticResource RegisterFieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="✉️" Style="{StaticResource IconLabelStyle}" />
                                    <Entry x:Name="EmailEntry" Grid.Column="1" Placeholder="email@vi-du.com" Keyboard="Email" Style="{StaticResource RegisterEntryStyle}" />
                                </Grid>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference EmailEntry}, Path=IsFocused}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource AppBrand}" />
                                        <Setter Property="StrokeThickness" Value="1.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Tên đăng nhập" Style="{StaticResource RegisterFieldLabelStyle}" />
                            <Border x:Name="UsernameBorder" Style="{StaticResource RegisterFieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="🪪" Style="{StaticResource IconLabelStyle}" />
                                    <Entry x:Name="UsernameEntry" Grid.Column="1" Placeholder="username123" Style="{StaticResource RegisterEntryStyle}" />
                                </Grid>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference UsernameEntry}, Path=IsFocused}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource AppBrand}" />
                                        <Setter Property="StrokeThickness" Value="1.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Mật khẩu" Style="{StaticResource RegisterFieldLabelStyle}" />
                            <Border x:Name="PasswordBorder" Style="{StaticResource RegisterFieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Label Text="🔒" Style="{StaticResource IconLabelStyle}" />

                                    <Entry x:Name="PasswordEntry"
                                           Grid.Column="1"
                                            Placeholder="Nhập mật khẩu"
                                            IsPassword="True"
                                            Style="{StaticResource PasswordEntryStyle}" />

                                     <Border Grid.Column="2" Style="{StaticResource PasswordToggleChipStyle}">
                                         <Label x:Name="PasswordVisibilityIcon"
                                                Text="👁"
                                                FontSize="15"
                                                Padding="6,4"
                                                VerticalTextAlignment="Center" />
                                         <Border.GestureRecognizers>
                                             <TapGestureRecognizer Tapped="OnTogglePasswordVisibilityTapped" />
                                         </Border.GestureRecognizers>
                                     </Border>
                                </Grid>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference PasswordEntry}, Path=IsFocused}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource AppBrand}" />
                                        <Setter Property="StrokeThickness" Value="1.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Xác nhận mật khẩu" Style="{StaticResource RegisterFieldLabelStyle}" />
                            <Border x:Name="ConfirmPasswordBorder" Style="{StaticResource RegisterFieldBorderStyle}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="🔐" Style="{StaticResource IconLabelStyle}" />

                                    <Entry x:Name="ConfirmPasswordEntry"
                                           Grid.Column="1"
                                            Placeholder="Nhập lại mật khẩu"
                                            IsPassword="True"
                                            Style="{StaticResource PasswordEntryStyle}" />
                                 </Grid>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Source={x:Reference ConfirmPasswordEntry}, Path=IsFocused}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource AppBrand}" />
                                        <Setter Property="StrokeThickness" Value="1.4" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="10" Margin="0,4,0,0">
                            <CheckBox x:Name="TermsCheckBox" Color="{StaticResource AppBrand}" />
                            <Label Text="Tôi đồng ý với Điều khoản sử dụng và Chính sách bảo mật của ứng dụng."
                                   FontSize="13"
                                   TextColor="{StaticResource AppSecondaryText}"
                                   LineBreakMode="WordWrap"
                                   VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>

                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                Shadow="0,10,18,#22000000"
                                Margin="0,2,0,0">
                            <Button x:Name="RegisterButton"
                                    Text="ĐĂNG KÝ"
                                    HeightRequest="54"
                                    CornerRadius="16"
                                    FontFamily="OpenSans-Semibold"
                                    FontSize="15"
                                    TextColor="{StaticResource AppBrandStrong}"
                                    Clicked="OnRegisterClicked">
                                <Button.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFD86A" Offset="0.0" />
                                        <GradientStop Color="{StaticResource AppBrandAccent}" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Button.Background>
                            </Button>
                        </Border>

                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,4,0,0">
                            <Label Text="Đã có tài khoản?" FontSize="14" TextColor="{StaticResource AppSecondaryText}" />
                            <Label Text="Đăng nhập"
                                   FontSize="14"
                                   FontFamily="OpenSans-Semibold"
                                   TextColor="{StaticResource AppBrand}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackToLoginTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>

