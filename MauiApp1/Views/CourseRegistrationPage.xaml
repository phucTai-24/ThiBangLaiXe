<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cm="clr-namespace:MauiApp1.Models.CourseModule"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.CourseRegistrationPage"
             Title="Đăng ký khóa học"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Padding="20,14"
                StrokeThickness="0"
                Shadow="0,4,12,#14000000">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="#F2F3F5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        VerticalOptions="Center">
                    <Label Text="←" FontSize="18" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Đăng ký khóa học" FontAttributes="Bold" FontSize="22" TextColor="#111827" />
                    <Label Text="Chọn lớp, nhập thông tin và thanh toán VNPAY" FontSize="13" TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,140" Spacing="12">
            <Label Text="Luồng đăng ký 3 bước" FontAttributes="Bold" FontSize="22" />
            <Label Text="Bước 1: Chọn lớp • Bước 2: Nhập thông tin • Bước 3: Thanh toán VNPAY" FontSize="12" TextColor="#64748B" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
            <Label Text="{Binding StatusMessage}" FontAttributes="Bold" />

            <Label Text="1) Danh sách khóa học" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Courses}" SelectionMode="Single" SelectionChanged="OnCourseSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="cm:Course">
                        <Border Stroke="#E2E8F0" StrokeThickness="1" Padding="12" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                                    <Border Grid.Column="1"
                                            BackgroundColor="#DCFCE7"
                                            Stroke="#86EFAC"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 10"
                                            Padding="8,2"
                                            IsVisible="{Binding IsRegistered}">
                                        <Label Text="Đã đăng ký" FontSize="11" FontAttributes="Bold" TextColor="#15803D" />
                                    </Border>
                                </Grid>
                                <Label Text="{Binding LicenseType}" FontSize="12" TextColor="#475569" />
                                <Label Text="{Binding Description}" FontSize="12" TextColor="#64748B" />
                                <Label Text="{Binding TuitionFee, StringFormat='Học phí: {0:N0}đ'}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="2) Danh sách lớp học" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Classes}" SelectionMode="Single" SelectionChanged="OnClassSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="cm:DrivingClass">
                        <Border Stroke="#E2E8F0" StrokeThickness="1" Padding="12" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                <Label Text="{Binding ClassCode, StringFormat='Mã lớp: {0}'}" FontSize="12" />
                                <Label Text="{Binding ScheduleText}" FontSize="12" TextColor="#64748B" />
                                <Label Text="{Binding AvailableSlots, StringFormat='Còn chỗ: {0}'}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="3) Thông tin học viên" FontAttributes="Bold" />
            <Entry x:Name="FullNameEntry" Placeholder="Họ và tên" />
            <Entry x:Name="PhoneEntry" Placeholder="Số điện thoại" Keyboard="Telephone" />
            <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
            <Entry x:Name="IdentityEntry" Placeholder="CCCD/CMND" Keyboard="Numeric" />
            <Editor x:Name="AddressEditor" Placeholder="Địa chỉ" AutoSize="TextChanges" />

            <Button Text="Tạo phiếu đăng ký (Chờ thanh toán)" Clicked="OnSubmitRegistrationClicked" />
            <Button x:Name="PayWithVnPayButton" Text="Thanh toán qua VNPAY" Clicked="OnPayWithVnPayClicked" />
            <Button Text="Kiểm tra kết quả thanh toán" Clicked="OnRefreshPaymentStatusClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNavView Grid.Row="2"
                                   CurrentTab="home" />
    </Grid>
</ContentPage>
