<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.PaymentResultPage"
             Title="Kết quả thanh toán"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Padding="20,14"
                StrokeThickness="0"
                Shadow="0,4,12,#14000000">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="#F2F3F5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        VerticalOptions="Center">
                    <Label Text="←" FontSize="18" TextColor="#111827" HorizontalOptions="Center" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Kết quả thanh toán" FontAttributes="Bold" FontSize="22" TextColor="#111827" />
                    <Label Text="Thông tin giao dịch và lớp học đã đăng ký" FontSize="13" TextColor="#64748B" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,140" Spacing="16">

        <Border BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 20"
                Padding="18"
                HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*">
                    <Frame Grid.Column="0" BackgroundColor="#DCFCE7" CornerRadius="20" Padding="8" HasShadow="False" HeightRequest="40" WidthRequest="40">
                        <Label Text="✓" HorizontalOptions="Center" VerticalOptions="Center" TextColor="#16A34A" FontSize="20" FontAttributes="Bold"/>
                    </Frame>
                    <Label Grid.Column="1" Text="Kết quả thanh toán" FontSize="18" FontAttributes="Bold" VerticalTextAlignment="Center" Margin="10,0,0,0" />
                </Grid>

                <Border BackgroundColor="#F8FAFC" Stroke="#E2E8F0" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding StatusTitle}" FontAttributes="Bold" TextColor="#0F172A" FontSize="16"/>
                        <Label Text="{Binding AmountText}" TextColor="#16A34A" FontAttributes="Bold" FontSize="22"/>
                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,4"/>
                        <Label Text="{Binding CourseText}" TextColor="#334155" FontSize="14"/>
                        <Label Text="{Binding ClassText}" TextColor="#334155" FontSize="14"/>
                        <Label Text="{Binding DetailText}" TextColor="#64748B" FontSize="13"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNavView Grid.Row="2"
                                   CurrentTab="home" />
    </Grid>
</ContentPage>
