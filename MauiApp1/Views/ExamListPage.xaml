<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiApp1.ViewModels"
             xmlns:examModels="clr-namespace:MauiApp1.Models.Exams"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.ExamListPage"
             x:DataType="viewmodels:ExamListViewModel"
             Style="{StaticResource AppPageStyle}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Style="{StaticResource AppHeaderContainer}"
                Shadow="0,8,20,#12000000">
            <Grid ColumnDefinitions="Auto,*"
                  Style="{StaticResource AppHeaderGrid}">
                <Border Style="{StaticResource AppIconButtonCard}"
                        VerticalOptions="Center">
                    <Label Text="🧪"
                           FontSize="18"
                           TextColor="{StaticResource AppPrimaryText}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="ONTHIBANGLAI"
                           Style="{StaticResource AppHeaderBrandLabel}" />
                    <Label Text="Chọn loại thi thử"
                           Style="{StaticResource AppHeaderTitleLabel}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,24,24,40" Spacing="18">
                <Border Padding="20"
                        BackgroundColor="#FFF8EA"
                        Stroke="#1AD5C4AB"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Bước 1: chọn bộ đề thi thử"
                               FontFamily="OpenSans-Semibold"
                               FontSize="22"
                               TextColor="#271900" />
                        <Label Text="Trước khi bắt đầu thi, bạn cần chọn đúng bộ đề từ API backend. Danh sách này được đọc trực tiếp từ các đề published trong hệ thống."
                               FontSize="14"
                               LineHeight="1.35"
                               TextColor="#5F564B" />
                        <Label Text="{Binding HeaderText}"
                               FontSize="13"
                               TextColor="#7C5800" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="16"
                        BackgroundColor="#FFFFFF"
                        Stroke="#14D5C4AB"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Chọn loại thi thử"
                               FontFamily="OpenSans-Semibold"
                               FontSize="14"
                               TextColor="#271900" />

                        <Picker Title="Loại bằng"
                                ItemsSource="{Binding LicenseTypes}"
                                SelectedItem="{Binding SelectedLicenseType}"
                                BackgroundColor="#F6F3EC"
                                TextColor="#271900"
                                HeightRequest="46" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="#7C5800"
                                   HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding Exams}">
                    <CollectionView.EmptyView>
                        <Border Padding="20"
                                BackgroundColor="#FFFFFF"
                                Stroke="#14D5C4AB"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24">
                            <Label Text="Chưa có đề thi thử nào được publish từ API backend."
                                   FontSize="14"
                                   TextColor="#5F564B"
                                   HorizontalTextAlignment="Center" />
                        </Border>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="examModels:SampleExamItem">
                            <Border Margin="0,0,0,16"
                                    Padding="20"
                                    BackgroundColor="#FFFFFF"
                                    Stroke="#14D5C4AB"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 24"
                                    Shadow="0,10,24,#0A1C1C18">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   FontFamily="OpenSans-Semibold"
                                                   FontSize="20"
                                                   TextColor="#271900" />
                                            <Label Text="{Binding Code, StringFormat='Mã đề: {0}'}"
                                                   FontSize="12"
                                                   TextColor="#6B6257" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="1"
                                                Padding="10,6"
                                                BackgroundColor="#E8F6EA"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 999">
                                            <Label Text="API"
                                                   FontSize="11"
                                                   FontFamily="OpenSans-Semibold"
                                                   TextColor="#2E7D32" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*,*"
                                          ColumnSpacing="10">
                                        <Border Padding="12"
                                                BackgroundColor="#FFF8EA"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Số câu"
                                                       FontSize="11"
                                                       TextColor="#6B6257" />
                                                <Label Text="{Binding TotalQuestions}"
                                                       FontFamily="OpenSans-Semibold"
                                                       FontSize="16"
                                                       TextColor="#7C5800" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Padding="12"
                                                BackgroundColor="#EEF6FF"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Thời gian"
                                                       FontSize="11"
                                                       TextColor="#6B6257" />
                                                <Label Text="{Binding DurationMinutes, StringFormat='{}{0} phút'}"
                                                       FontFamily="OpenSans-Semibold"
                                                       FontSize="16"
                                                       TextColor="#005295" />
                                            </VerticalStackLayout>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Padding="12"
                                                BackgroundColor="#F6E8FB"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="Liên kết câu"
                                                       FontSize="11"
                                                       TextColor="#6B6257" />
                                                <Label Text="{Binding LinkedQuestionCount}"
                                                       FontFamily="OpenSans-Semibold"
                                                       FontSize="16"
                                                       TextColor="#7B1FA2" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </Grid>

                                    <Button Text="Bắt đầu thi thử"
                                            BackgroundColor="#FFB800"
                                            TextColor="#271900"
                                            FontFamily="OpenSans-Semibold"
                                            CornerRadius="22"
                                            HeightRequest="50"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.StartExamCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNavView Grid.Row="2"
                                   CurrentTab="exam" />

        <controls:ChatOverlayView Grid.RowSpan="3" />
    </Grid>

</ContentPage>
