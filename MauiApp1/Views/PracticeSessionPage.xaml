<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             xmlns:models="clr-namespace:MauiApp1.Models"
             xmlns:converters="clr-namespace:MauiApp1.Converters"
             x:Class="MauiApp1.Views.PracticeSessionPage"
             x:DataType="vm:PracticeSessionViewModel"
             Style="{StaticResource AppPageStyle}"
             Padding="16,12,16,12">

    <ContentPage.Resources>
        <converters:IsFalseConverter x:Key="IsFalseConverter" />

        <Style x:Key="MetaLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSans-Semibold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#6B7280" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="AnswerCardBaseStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Stroke" Value="#E7EAF0" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Shadow" Value="0,6,16,#0A000000" />
            <Style.Triggers>
                <MultiTrigger TargetType="Border">
                    <MultiTrigger.Conditions>
                        <BindingCondition Binding="{Binding IsRevealed}" Value="True" />
                        <BindingCondition Binding="{Binding IsCorrectAnswer}" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="BackgroundColor" Value="#EAF8EF" />
                    <Setter Property="Stroke" Value="#22A05A" />
                    <Setter Property="StrokeThickness" Value="2" />
                </MultiTrigger>

                <MultiTrigger TargetType="Border">
                    <MultiTrigger.Conditions>
                        <BindingCondition Binding="{Binding IsRevealed}" Value="True" />
                        <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                        <BindingCondition Binding="{Binding IsCorrectAnswer}" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="BackgroundColor" Value="#FDECEC" />
                    <Setter Property="Stroke" Value="#DC2626" />
                    <Setter Property="StrokeThickness" Value="2" />
                </MultiTrigger>

                <MultiTrigger TargetType="Border">
                    <MultiTrigger.Conditions>
                        <BindingCondition Binding="{Binding IsSelected}" Value="True" />
                        <BindingCondition Binding="{Binding IsRevealed}" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="BackgroundColor" Value="#EEF5FF" />
                    <Setter Property="Stroke" Value="#2563EB" />
                    <Setter Property="StrokeThickness" Value="2" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="16">
            <Grid x:Name="QuestionViewport"
                  RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="12">

        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Padding="14"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 18"
                Shadow="0,8,22,#10000000">
            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12"
                  RowSpacing="10">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        BackgroundColor="#F2F3F5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        VerticalOptions="Center">
                    <Label Text="‹"
                           FontSize="28"
                           TextColor="#111827"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TranslationY="-2" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoPracticeHomeCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="1"
                                     VerticalOptions="Center">
                    <Label Text="{Binding CurrentQuestionText}"
                           FontFamily="OpenSans-Semibold"
                           FontSize="20"
                           TextColor="#111827" />
                    <Label Text="Phiên ôn tập"
                           FontSize="12"
                           TextColor="#9CA3AF" />
                </VerticalStackLayout>

                <Border Grid.Row="1"
                        Grid.ColumnSpan="3"
                        BackgroundColor="#F5F7FA"
                        Padding="10,8"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10">
                        <Label Text="{Binding AnsweredQuestionsText}"
                               Style="{StaticResource MetaLabelStyle}" />
                        <Label Grid.Column="1"
                               Text="{Binding CorrectQuestionsText}"
                               Style="{StaticResource MetaLabelStyle}"
                               TextColor="#15803D" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                BackgroundColor="#FFFFFF"
                Padding="14"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Shadow="0,8,22,#0D000000"
                IsVisible="{Binding CurrentQuestion, Converter={StaticResource IsNotNullConverter}}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="8">
                        <Border Padding="8,4"
                                BackgroundColor="#EEF5FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999">
                            <Label Text="{Binding CurrentQuestion.Category}"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="10"
                                   TextColor="#2563EB" />
                        </Border>
                        <Border Padding="8,4"
                                BackgroundColor="#FFF3E8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                IsVisible="{Binding CurrentQuestion.IsCritical}">
                            <Label Text="Điểm liệt"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="10"
                                   TextColor="#C2410C" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <Label Grid.Row="1"
                       Text="{Binding CurrentQuestion.Text}"
                       FontFamily="OpenSans-Semibold"
                       FontSize="18"
                       LineHeight="1.2"
                       MaxLines="4"
                       TextColor="#111827" />

                <Border Grid.Row="2"
                        BackgroundColor="#F8FAFC"
                        Padding="8"
                        Stroke="#E5E7EB"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        IsVisible="{Binding CurrentQuestion.HasImage}">
                    <Grid HeightRequest="260">
                        <Image Source="{Binding CurrentQuestion.QuestionImageSource}"
                               Aspect="AspectFit"
                               IsVisible="{Binding CurrentQuestion.HasDisplayImage}"
                               HandlerChanged="OnQuestionImageHandlerChanged" />

                        <VerticalStackLayout Spacing="6"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             IsVisible="{Binding CurrentQuestion.ShowImagePlaceholder}">
                            <Label Text="🖼️"
                                   FontSize="28"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Không tải được hình ảnh"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="12"
                                   TextColor="#9CA3AF"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        BackgroundColor="#FFFFFF"
                        Padding="0"
                        StrokeThickness="0"
                        IsVisible="{Binding CurrentQuestion.HasImage, Converter={StaticResource IsFalseConverter}}">
                    <VerticalStackLayout Spacing="0"
                                         BindableLayout.ItemsSource="{Binding CurrentQuestion.Answers}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PracticeAnswerOption">
                                <Border Style="{StaticResource AnswerCardBaseStyle}">
                                    <Grid ColumnDefinitions="36,*"
                                          ColumnSpacing="10"
                                          VerticalOptions="Center">
                                        <Border WidthRequest="32"
                                                HeightRequest="32"
                                                BackgroundColor="#F3F4F6"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16"
                                                VerticalOptions="Center">
                                            <Label Text="{Binding Label}"
                                                   FontFamily="OpenSans-Semibold"
                                                   FontSize="14"
                                                   TextColor="#374151"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <Label Grid.Column="1"
                                               Text="{Binding Text}"
                                               FontSize="14"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation"
                                               TextColor="#111827"
                                               VerticalTextAlignment="Center" />
                                    </Grid>

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="0.98" />
                                                    <Setter Property="Opacity" Value="0.92" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectAnswerCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Grid Grid.Row="3"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="10">
                    <Button Text="QUAY LẠI"
                            BackgroundColor="#EEF2F7"
                            TextColor="#374151"
                            FontFamily="OpenSans-Semibold"
                            FontSize="12"
                            CornerRadius="18"
                            HeightRequest="40"
                            Command="{Binding PreviousQuestionCommand}" />

                    <Button Grid.Column="1"
                            Text="TIẾP THEO"
                            BackgroundColor="#2563EB"
                            TextColor="#FFFFFF"
                            FontFamily="OpenSans-Semibold"
                            FontSize="12"
                            CornerRadius="18"
                            HeightRequest="40"
                            Command="{Binding NextQuestionCommand}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                BackgroundColor="#FFFFFF"
                Padding="12,12,12,4"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                Shadow="0,-4,22,#10000000"
                IsEnabled="{Binding CurrentQuestion.HasImage}"
                IsVisible="{Binding CurrentQuestion, Converter={StaticResource IsNotNullConverter}}">
            <Border.Triggers>
                <DataTrigger TargetType="Border"
                             Binding="{Binding CurrentQuestion.HasImage}"
                             Value="False">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </Border.Triggers>
            <VerticalStackLayout Spacing="0"
                                 BindableLayout.ItemsSource="{Binding CurrentQuestion.Answers}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:PracticeAnswerOption">
                        <Border Style="{StaticResource AnswerCardBaseStyle}">
                            <Grid ColumnDefinitions="36,*"
                                  ColumnSpacing="10"
                                  VerticalOptions="Center">
                                <Border WidthRequest="32"
                                        HeightRequest="32"
                                        BackgroundColor="#F3F4F6"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Label}"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="14"
                                           TextColor="#374151"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding Text}"
                                       FontSize="14"
                                       MaxLines="2"
                                       LineBreakMode="TailTruncation"
                                       TextColor="#111827"
                                       VerticalTextAlignment="Center" />
                            </Grid>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Property="Scale" Value="0.98" />
                                            <Setter Property="Opacity" Value="0.92" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectAnswerCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>
            </Grid>

            <Border BackgroundColor="#FFFFFF"
                    Padding="18"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Shadow="0,12,30,#12000000">
                <VerticalStackLayout Spacing="18">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4"
                                             VerticalOptions="Center">
                            <Label Text="Danh sách câu"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="20"
                                   TextColor="#111827" />
                            <Label Text="Trắng: chưa làm • Xanh: đúng • Đỏ: sai"
                                   FontSize="12"
                                   TextColor="#6B7280" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="#111827"
                                Padding="16,10"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                VerticalOptions="Center">
                            <Label Text="Nộp bài"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="13"
                                   TextColor="#FFFFFF" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SubmitPracticeCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <CollectionView ItemsSource="{Binding Questions}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical"
                                             Span="5"
                                             HorizontalItemSpacing="10"
                                             VerticalItemSpacing="10" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PracticeQuestionItem">
                                <Border WidthRequest="46"
                                        HeightRequest="46"
                                        HorizontalOptions="Center"
                                        BackgroundColor="#F2F2F2"
                                        Stroke="#E5E7EB"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 23">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BackgroundColor" Value="#F2F2F2" />
                                            <Setter Property="Stroke" Value="#E5E7EB" />
                                            <Setter Property="StrokeThickness" Value="1" />
                                            <Setter Property="Shadow" Value="0,0,0,#00000000" />

                                            <Style.Triggers>
                                                <MultiTrigger TargetType="Border">
                                                    <MultiTrigger.Conditions>
                                                        <BindingCondition Binding="{Binding IsAnswered}" Value="True" />
                                                        <BindingCondition Binding="{Binding IsCorrectlyAnswered}" Value="True" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="BackgroundColor" Value="#E8F5E9" />
                                                    <Setter Property="Stroke" Value="#A5D6A7" />
                                                </MultiTrigger>

                                                <MultiTrigger TargetType="Border">
                                                    <MultiTrigger.Conditions>
                                                        <BindingCondition Binding="{Binding IsAnswered}" Value="True" />
                                                        <BindingCondition Binding="{Binding IsCorrectlyAnswered}" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter Property="BackgroundColor" Value="#FDECEA" />
                                                    <Setter Property="Stroke" Value="#F5B7B1" />
                                                </MultiTrigger>

                                                <DataTrigger TargetType="Border"
                                                             Binding="{Binding IsCurrent}"
                                                             Value="True">
                                                    <Setter Property="BackgroundColor" Value="#E3F2FD" />
                                                    <Setter Property="Stroke" Value="#2196F3" />
                                                    <Setter Property="StrokeThickness" Value="2" />
                                                    <Setter Property="Shadow" Value="0,8,18,#332196F3" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Label Text="{Binding Number}"
                                           FontFamily="OpenSans-Semibold"
                                           FontSize="14"
                                           TextColor="#111827"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Pressed">
                                                <VisualState.Setters>
                                                    <Setter Property="Scale" Value="0.94" />
                                                    <Setter Property="Opacity" Value="0.88" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectQuestionCommand}"
                                                              CommandParameter="{Binding Number}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
