<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MauiApp1.ViewModels"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.TrafficSignsPage"
             x:DataType="vm:PracticeViewModel"
             Style="{StaticResource AppPageStyle}">

    <ContentPage.Resources>
        <Style x:Key="PracticeCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 24" />
            <Setter Property="Shadow" Value="0,14,32,#14000000" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSans-Semibold" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="TextColor" Value="#151515" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>

        <Style x:Key="CardDescriptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="1.35" />
            <Setter Property="TextColor" Value="#6F6F6F" />
        </Style>

        <Style x:Key="BadgeTextStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSans-Semibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="StartButtonTextStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSans-Semibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                BackgroundColor="#FFFFFF"
                Padding="20,14"
                StrokeThickness="0"
                Shadow="0,8,24,#0D000000">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14"
                  VerticalOptions="Center">
                <Border WidthRequest="44"
                        HeightRequest="44"
                        BackgroundColor="#F2F3F5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22">
                    <Label Text="‹"
                           FontSize="30"
                           TextColor="#242424"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           TranslationY="-2" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="ONTHIBANGLAI"
                           FontFamily="OpenSans-Semibold"
                           FontSize="11"
                           TextColor="#9A9A9A"
                           CharacterSpacing="1.4" />
                    <Label Text="Ôn tập"
                           FontFamily="OpenSans-Semibold"
                           FontSize="26"
                           TextColor="#151515" />
                </VerticalStackLayout>

                <Border Grid.Column="2"
                        BackgroundColor="#EAF7EF"
                        Padding="10,6"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 999"
                        VerticalOptions="Center">
                    <Label Text="LIVE API"
                           FontFamily="OpenSans-Semibold"
                           FontSize="11"
                           TextColor="#1B8F4A" />
                </Border>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,22,20,128"
                                 Spacing="18">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   Color="#2563EB"
                                   HorizontalOptions="Center" />

                <Border Background="#EAF1FF"
                        Padding="18"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <VerticalStackLayout Spacing="5"
                                             VerticalOptions="Center">
                            <Label Text="Chọn nội dung cần luyện"
                                   FontFamily="OpenSans-Semibold"
                                   FontSize="20"
                                   TextColor="#123D6B" />
                            <Label Text="Tập trung ôn theo từng nhóm câu hỏi để cải thiện kết quả nhanh hơn."
                                   FontSize="13"
                                   LineHeight="1.35"
                                   TextColor="#507093" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                WidthRequest="52"
                                HeightRequest="52"
                                BackgroundColor="#FFFFFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 26"
                                VerticalOptions="Center">
                            <Label Text="📚"
                                   FontSize="26"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource PracticeCardStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="16"
                          RowSpacing="14">
                        <Border WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="#FFF3E8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28">
                            <Label Text="⚠️"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5"
                                             VerticalOptions="Center">
                            <Label Text="Ôn điểm liệt"
                                   Style="{StaticResource CardTitleStyle}" />
                            <Label Text="Tập trung nhóm câu hỏi bắt buộc không được sai trong bài thi."
                                   Style="{StaticResource CardDescriptionStyle}" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Border BackgroundColor="#FFF3E8"
                                    Padding="12,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="{Binding CriticalQuestionCount, StringFormat='Hiện có {0} câu điểm liệt'}"
                                       Style="{StaticResource BadgeTextStyle}"
                                       TextColor="#C2410C" />
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="18,10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    VerticalOptions="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F97316" Offset="0.0" />
                                        <GradientStop Color="#EA580C" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="Bắt đầu"
                                       Style="{StaticResource StartButtonTextStyle}" />
                            </Border>
                        </Grid>
                    </Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.98" />
                                    <Setter Property="Opacity" Value="0.92" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartCriticalPracticeCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border Style="{StaticResource PracticeCardStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="16"
                          RowSpacing="14">
                        <Border WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="#EEF5FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28">
                            <Label Text="📘"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5"
                                             VerticalOptions="Center">
                            <Label Text="Quy tắc giao thông đường bộ"
                                   Style="{StaticResource CardTitleStyle}" />
                            <Label Text="Ôn nhóm quy tắc chung và hành vi khi tham gia giao thông."
                                   Style="{StaticResource CardDescriptionStyle}" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Border BackgroundColor="#EEF5FF"
                                    Padding="12,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="{Binding TrafficRulesQuestionCount, StringFormat='Hiện có {0} câu quy tắc'}"
                                       Style="{StaticResource BadgeTextStyle}"
                                       TextColor="#2563EB" />
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="18,10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    VerticalOptions="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0.0" />
                                        <GradientStop Color="#2563EB" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="Bắt đầu"
                                       Style="{StaticResource StartButtonTextStyle}" />
                            </Border>
                        </Grid>
                    </Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.98" />
                                    <Setter Property="Opacity" Value="0.92" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartTrafficRulesPracticeCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border Style="{StaticResource PracticeCardStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="16"
                          RowSpacing="14">
                        <Border WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="#F3E8FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28">
                            <Label Text="🤝"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5"
                                             VerticalOptions="Center">
                            <Label Text="Văn hóa và đạo đức lái xe"
                                   Style="{StaticResource CardTitleStyle}" />
                            <Label Text="Ôn cách ứng xử văn minh, trách nhiệm và an toàn khi tham gia giao thông."
                                   Style="{StaticResource CardDescriptionStyle}" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Border BackgroundColor="#F3E8FF"
                                    Padding="12,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="{Binding DrivingCultureQuestionCount, StringFormat='Hiện có {0} câu văn hóa'}"
                                       Style="{StaticResource BadgeTextStyle}"
                                       TextColor="#7E22CE" />
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="18,10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    VerticalOptions="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#A855F7" Offset="0.0" />
                                        <GradientStop Color="#7E22CE" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="Bắt đầu"
                                       Style="{StaticResource StartButtonTextStyle}" />
                            </Border>
                        </Grid>
                    </Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.98" />
                                    <Setter Property="Opacity" Value="0.92" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartDrivingCulturePracticeCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border Style="{StaticResource PracticeCardStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="16"
                          RowSpacing="14">
                        <Border WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="#ECFDF5"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28">
                            <Label Text="🛠️"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5"
                                             VerticalOptions="Center">
                            <Label Text="Kỹ thuật lái xe"
                                   Style="{StaticResource CardTitleStyle}" />
                            <Label Text="Ôn kiến thức kỹ thuật cơ bản đối với xe mô tô và cách vận hành an toàn."
                                   Style="{StaticResource CardDescriptionStyle}" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Border BackgroundColor="#ECFDF5"
                                    Padding="12,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="{Binding DrivingTechniqueQuestionCount, StringFormat='Hiện có {0} câu kỹ thuật'}"
                                       Style="{StaticResource BadgeTextStyle}"
                                       TextColor="#047857" />
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="18,10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    VerticalOptions="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#10B981" Offset="0.0" />
                                        <GradientStop Color="#047857" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="Bắt đầu"
                                       Style="{StaticResource StartButtonTextStyle}" />
                            </Border>
                        </Grid>
                    </Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.98" />
                                    <Setter Property="Opacity" Value="0.92" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartDrivingTechniquePracticeCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border Style="{StaticResource PracticeCardStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="16"
                          RowSpacing="14">
                        <Border WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="#EAF7EF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28">
                            <Label Text="🚦"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5"
                                             VerticalOptions="Center">
                            <Label Text="Ôn tập biển báo"
                                   Style="{StaticResource CardTitleStyle}" />
                            <Label Text="Luyện nhóm câu có hình ảnh và nội dung liên quan đến biển báo giao thông."
                                   Style="{StaticResource CardDescriptionStyle}" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Border BackgroundColor="#EAF7EF"
                                    Padding="12,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="{Binding TrafficSignsQuestionCount, StringFormat='Hiện có {0} câu biển báo'}"
                                       Style="{StaticResource BadgeTextStyle}"
                                       TextColor="#15803D" />
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="18,10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    VerticalOptions="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#22C55E" Offset="0.0" />
                                        <GradientStop Color="#16A34A" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="Bắt đầu"
                                       Style="{StaticResource StartButtonTextStyle}" />
                            </Border>
                        </Grid>
                    </Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.98" />
                                    <Setter Property="Opacity" Value="0.92" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartTrafficSignsPracticeCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border Style="{StaticResource PracticeCardStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          ColumnDefinitions="Auto,*"
                          ColumnSpacing="16"
                          RowSpacing="14">
                        <Border WidthRequest="56"
                                HeightRequest="56"
                                BackgroundColor="#EAF1FF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 28">
                            <Label Text="🛣️"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="5"
                                             VerticalOptions="Center">
                            <Label Text="Ôn tập sa hình"
                                   Style="{StaticResource CardTitleStyle}" />
                            <Label Text="Luyện nhóm câu có hình ảnh về xử lý tình huống và thứ tự xe đi đúng luật."
                                   Style="{StaticResource CardDescriptionStyle}" />
                        </VerticalStackLayout>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <Border BackgroundColor="#EAF1FF"
                                    Padding="12,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Center">
                                <Label Text="{Binding SituationalQuestionCount, StringFormat='Hiện có {0} câu sa hình'}"
                                       Style="{StaticResource BadgeTextStyle}"
                                       TextColor="#2563EB" />
                            </Border>

                            <Border Grid.Column="1"
                                    Padding="18,10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    VerticalOptions="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0.0" />
                                        <GradientStop Color="#2563EB" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Label Text="Bắt đầu"
                                       Style="{StaticResource StartButtonTextStyle}" />
                            </Border>
                        </Grid>
                    </Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup Name="CommonStates">
                            <VisualState Name="Normal" />
                            <VisualState Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="Scale" Value="0.98" />
                                    <Setter Property="Opacity" Value="0.92" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding StartSituationalPracticeCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <controls:AppBottomNavView Grid.Row="2"
                                   CurrentTab="practice" />

        <controls:ChatOverlayView Grid.RowSpan="3" />
    </Grid>

</ContentPage>
